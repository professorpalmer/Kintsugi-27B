@@ -0,0 +1,93 @@
+"""Gate ESCHA_MLX_DENSE_PAIR_M1: two coded linears that share one input run as one pair dispatch at one row.
+
+Contract: at one row, project_pair with the pair path gives the same f16 bits as the two single calls (each of which
+is the stage-8 fused one-row path), for both code rates and with a bias. With the knob off, one row keeps the two
+single calls.
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-21.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal, needs_mlx
+
+
+def _pair(monkeypatch, on, K0: int, K1: int, IC: int, OC0: int, OC1: int, seed: int, bias: bool = False):
+    """on=None leaves ESCHA_MLX_DENSE_PAIR_M1 as the caller set it (unset = the default)."""
+    from escha_mlx import dense
+    if on is not None:
+        monkeypatch.setenv("ESCHA_MLX_DENSE_PAIR_M1", "1" if on else "0")
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    rng = np.random.default_rng(seed)
+    mods = []
+    for K, OC in ((K0, OC0), (K1, OC1)):
+        code = rng.integers(-2**15, 2**15, size=(IC // 16, OC // 16, 16 * K), dtype=np.int64).astype(np.int16)
+        rin = (rng.random(IC) + 0.5).astype(np.float16)
+        rout = (rng.random(OC) + 0.5).astype(np.float16)
+        b = (rng.standard_normal(OC) * 0.1).astype(np.float16) if bias else None
+        mods.append(dense.EschaLinear(dense.EschaWeight(code, rin, rout), bias=b))
+    return mods
+
+
+@needs_metal
+@pytest.mark.parametrize("K0,K1", [(2, 2), (3, 3), (2, 3)])
+@pytest.mark.parametrize("IC,OC0,OC1", [(256, 512, 512), (512, 1024, 256)])
+@pytest.mark.parametrize("bias", [False, True])
+def test_pair_m1_matches_single_calls_bit_exact(monkeypatch, K0, K1, IC, OC0, OC1, bias):
+    import mlx.core as mx
+    from escha_mlx import dense
+    seed = K0 * 100 + K1 * 10 + IC + OC0 + OC1 + bias
+    on = _pair(monkeypatch, True, K0, K1, IC, OC0, OC1, seed, bias)
+    off = _pair(monkeypatch, False, K0, K1, IC, OC0, OC1, seed, bias)
+    assert on[0]._pair_m1 and on[1]._pair_m1 and not off[0]._pair_m1
+    rng = np.random.default_rng(seed + 7)
+    for i in range(5):
+        x = mx.array(rng.standard_normal((1, 1, IC)).astype(np.float16))
+        p0, p1 = dense.project_pair(on[0], on[1], x)
+        q0, q1 = off[0](x), off[1](x)
+        assert p0.shape == (1, 1, OC0) and p1.shape == (1, 1, OC1)
+        assert np.array_equal(np.array(p0), np.array(q0)), f"row {i}, first"
+        assert np.array_equal(np.array(p1), np.array(q1)), f"row {i}, second"
+
+
+@needs_mlx
+def test_pair_m1_default_off_and_latched(monkeypatch):
+    from escha_mlx import msl
+    monkeypatch.delenv("ESCHA_MLX_DENSE_PAIR_M1", raising=False)
+    assert msl.use_dense_pair_m1() is False
+    default = _pair(monkeypatch, None, 2, 2, 256, 512, 512, 1)      # built with the knob unset
+    assert default[0]._pair_m1 is False and default[1]._pair_m1 is False
+    on = _pair(monkeypatch, True, 2, 2, 256, 512, 512, 1)
+    assert on[0]._pair_m1 is True
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PAIR_M1", "0")                # a later flip does not reach built modules
+    assert on[0]._pair_m1 is True
+
+
+@needs_metal
+def test_pair_m1_really_dispatches_the_pair_kernels(monkeypatch):
+    """Guard against a vacuous equality: with the knob on, one row reaches the pair kernels once each; with it off,
+    one row never reaches them."""
+    import mlx.core as mx
+    from escha_mlx import dense, msl
+    calls = {"had_pair": 0, "pair_out": 0}
+    real_had, real_out = msl.dense_scaled_had_pair, msl.dense_gemm_pair_out
+
+    def spy_had(*a, **k):
+        calls["had_pair"] += 1
+        return real_had(*a, **k)
+
+    def spy_out(*a, **k):
+        calls["pair_out"] += 1
+        return real_out(*a, **k)
+
+    on = _pair(monkeypatch, True, 2, 3, 256, 512, 256, 5)
+    off = _pair(monkeypatch, False, 2, 3, 256, 512, 256, 5)
+    monkeypatch.setattr(msl, "dense_scaled_had_pair", spy_had)
+    monkeypatch.setattr(msl, "dense_gemm_pair_out", spy_out)
+    x = mx.array(np.ones((1, 1, 256), dtype=np.float16))
+    mx.eval(*dense.project_pair(on[0], on[1], x))
+    assert calls == {"had_pair": 1, "pair_out": 1}
+    mx.eval(*dense.project_pair(off[0], off[1], x))
+    assert calls == {"had_pair": 1, "pair_out": 1}
