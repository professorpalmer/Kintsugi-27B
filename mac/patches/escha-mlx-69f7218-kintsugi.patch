+@pytest.mark.parametrize("edge,n_layers", [(4, 64), (0, 64), (1, 3), (40, 64)])
+def test_keep_edge_layers_f16(edge, n_layers, monkeypatch):
+    from escha_mlx.loader import keep_edge_layers_f16
+    monkeypatch.setenv("ESCHA_MLX_DENSE_INT8_EDGE", str(edge))
+    m = _fake_stack(n_layers)
+    n = keep_edge_layers_f16(m)
+    off = [i for i, layer in enumerate(m.model.layers) if not layer.mlp.int8_ok]
+    assert off == [i for i, layer in enumerate(m.model.layers) if not layer.self_attn.int8_ok]
+    assert off == [i for i in range(n_layers) if i < edge or i >= n_layers - edge]
+    assert n == 2 * len(off)
+    assert m.model.norm.int8_ok is True
