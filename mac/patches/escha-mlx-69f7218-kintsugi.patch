+class EschaAffineLinear(nn.Module):
+    """A pre-quantized MLX affine linear (any bits / group) with f32 scales and biases; y in x's dtype.
+
+    Used for a quantized MTP head (for example ggml Q4_0 blocks: bits 4, group 32, scale d, bias -8 d, exact).
+    The parameters start as zeros of the right shapes so a loader can fill them by name.
+    """
+
+    def __init__(self, out_features: int, in_features: int, group_size: int, bits: int) -> None:
+        super().__init__()
+        if in_features % group_size or (in_features * bits) % 32:
+            raise ValueError(f"in_features {in_features} does not fit group {group_size} / bits {bits}")
+        self.weight = mx.zeros((out_features, in_features * bits // 32), dtype=mx.uint32)
+        self.scales = mx.zeros((out_features, in_features // group_size), dtype=mx.float32)
+        self.biases = mx.zeros((out_features, in_features // group_size), dtype=mx.float32)
+        self._group_size = group_size
+        self._bits = bits
+
+    def __call__(self, x: mx.array) -> mx.array:
+        y = mx.quantized_matmul(x, self.weight, self.scales, self.biases, transpose=True,
+                                group_size=self._group_size, bits=self._bits)
+        return y.astype(x.dtype)
+
+
+class CpuQ8Embedding(nn.Module):
+    """Q8 token embedding kept on the CPU side as read-only memory maps (ESCHA_MLX_EMBED_CPU=1).
+
+    The table never becomes an MLX array, so it is not part of the GPU working set (Kintsugi-27B: 1.59 GB as
+    repacked u32 + f32 scales + f32 biases). A call gathers only the rows of the given ids and dequantizes them
+    in numpy: f16(f32(w8) * f32(d)), the same value as EschaQ8Embedding (MLX's affine dequant in f32 is exact,
+    see validate_pack / validate_pack_grouped, and both round the f32 result to f16 once). The cost: the ids
+    must be known on the host, so a decode step waits for the previous token before its graph is built.
+    ``scale`` is [N] (one per row) or [N, K/g] (one per group of g weights).
+    """
+
+    def __init__(self, w8: np.ndarray, scale: np.ndarray, dtype=mx.float16) -> None:
+        super().__init__()
+        n, k = w8.shape
+        if scale.ndim == 1:
+            if scale.shape[0] != n:
+                raise ValueError(f"weight_scale {scale.shape} does not match weight_int8 {w8.shape}")
+            self._g = k
+        elif scale.ndim == 2 and scale.shape[0] == n and k % scale.shape[1] == 0:
+            self._g = k // scale.shape[1]
+        else:
+            raise ValueError(f"scale {scale.shape} does not tile weight_int8 {w8.shape}")
+        self._w8 = w8
+        self._scale = scale.reshape(n, -1)
+        self._dtype = dtype
+        self._shape = (n, k)
+
+    def rows(self, ids: np.ndarray) -> np.ndarray:
+        """f16 rows for a flat int array of ids (numpy in, numpy out)."""
+        ids = np.asarray(ids, dtype=np.int64).reshape(-1)
+        n, k = self._shape
+        if ids.size and (ids.min() < 0 or ids.max() >= n):
+            raise IndexError(f"token id out of range 0..{n - 1}")
+        w = self._w8[ids].astype(np.float32).reshape(ids.size, k // self._g, self._g)
+        d = self._scale[ids].astype(np.float32)[:, :, None]
+        return (w * d).reshape(ids.size, k).astype(np.float16)
+
+    def __call__(self, ids: mx.array) -> mx.array:
+        host = np.array(ids)
+        out = mx.array(self.rows(host).reshape(*host.shape, self._shape[1]))
+        return out if self._dtype == mx.float16 else out.astype(self._dtype)
+
+    def as_linear(self, x: mx.array) -> mx.array:
+        raise NotImplementedError("CpuQ8Embedding cannot serve a tied head; load with ESCHA_MLX_EMBED_CPU=0")
+
+
+def make_embedding_cpu(w8: np.ndarray, scale: np.ndarray) -> nn.Module:
+    if dense_mode() == "fp16":
+        raise ValueError("ESCHA_MLX_EMBED_CPU=1 needs ESCHA_MLX_DENSE=q8")
+    return CpuQ8Embedding(w8, scale)
