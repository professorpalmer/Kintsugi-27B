+    d.observe([1500])
+    assert d.vocab == 0
+
+
+@needs_mlx
+def test_generator_feeds_verified_ids_to_the_draft_rule(tmp_path, monkeypatch):
+    """Wiring of the draft vocabulary rule inside mtp_generate_step: the rule observes exactly the verified output
+    tokens, and every draft-head call gets the prefix that the rule gives for the context at that moment."""
+    import types
+
+    import mlx.core as mx
+    from mlx_lm.generate import generate_step
+
+    from escha_mlx import envs, mtp
+    from escha_mlx.mtp import MTPHead, load_mtp, mtp_generate_step
+
+    mx.random.seed(21)
+    target = _target()
+    target.eval()
+    _write_mtp(tmp_path, target)
+    head = load_mtp(tmp_path, target)
+    prompt = mx.array([3, 9, 4], dtype=mx.uint32)
+    reference = [int(t) for t, _ in generate_step(prompt, target, max_tokens=16)]
+    n = sorted(reference)[len(reference) // 2] or 1                        # about half the output is "high"
+    window = 2
+    monkeypatch.setattr(mtp, "_DRAFT_VOCAB_WINDOW", window)
+    proxy = types.SimpleNamespace(**{k: getattr(envs, k) for k in dir(envs) if k.startswith("ESCHA_")})
+    proxy.ESCHA_MLX_MTP_DRAFT_VOCAB = types.SimpleNamespace(get=lambda: n)
+    monkeypatch.setattr(mtp, "envs", proxy)
+    events = []
+    real_logits, real_observe = MTPHead.logits, mtp._DraftVocab.observe
+
+    def logits(self, hidden, vocab=0):
+        events.append(("logits", vocab))
+        return real_logits(self, hidden, vocab)
+
+    def observe(self, ids):
+        events.append(("observe", [int(i) for i in ids]))
+        return real_observe(self, ids)
+
+    real_tree = mtp._propose_tree
+
+    def propose(*args, **kwargs):
+        events.append(("tree", kwargs.get("draft_vocab", 0)))
+        return real_tree(*args, **kwargs)
+
+    monkeypatch.setattr(MTPHead, "logits", logits)
+    monkeypatch.setattr(mtp._DraftVocab, "observe", observe)
+    monkeypatch.setattr(mtp, "_propose_tree", propose)
+    generated = [t for t, _, _ in mtp_generate_step(prompt, target, mtp_head=head, max_tokens=16)]
+    assert generated == reference                                          # the tiny head has no prefix: output exact
+
+    observed = [i for kind, v in events if kind == "observe" for i in v]
+    assert observed == generated[: len(observed)] and len(observed) >= len(generated) - 1
+    trees = [i for i, (kind, _) in enumerate(events) if kind == "tree"]
+    assert trees
+    for i in trees:                                                         # the seed logits of each tree use its prefix
+        seed = next(value for kind, value in reversed(events[:i]) if kind == "logits")
+        assert seed == events[i][1], (i, events[: i + 1])
+    context, seen_vocab = [int(i) for i in np.array(prompt)], []
+    for kind, value in events:
+        if kind == "observe":
+            context += value
+            continue
+        if kind == "tree":
+            continue
+        high = [i for i, token in enumerate(context) if token >= n]
+        expected = n if not high or len(context) - high[-1] > window else 0
+        assert value == expected, (context, value)
+        seen_vocab.append(value)
+    assert {0, n} <= set(seen_vocab), seen_vocab                            # both states occur: not vacuous
