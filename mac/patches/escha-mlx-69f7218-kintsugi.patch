+@needs_metal
+@pytest.mark.parametrize("grouped", [False, True])
+@pytest.mark.parametrize("rows", [1, 4, 9])
+@pytest.mark.parametrize("flag", ["0", "1"])
+def test_q8_head_prefix_logits_equal_the_full_columns(monkeypatch, rows, flag, grouped):
+    """prefix_logits(x, n) gives the first n columns of head(x), bit for bit, on both kernel paths, with one
+    scale per row (stock export) and one scale per group (pack_q8_grouped)."""
+    import mlx.core as mx
+
+    from escha_mlx import quant
+
+    rng = np.random.default_rng(1300 + rows)
+    n, k = 300, 512
+    w8 = rng.integers(-127, 128, size=(n, k), dtype=np.int8)
+    if grouped:
+        packed, scales, biases, g = quant.pack_q8_grouped(w8, (rng.random((n, k // 32)) * 0.01 + 1e-3).astype(np.float16))
+    else:
+        g = 128
+        packed, scales, biases = quant.pack_q8(w8, (rng.random(n) * 0.01 + 1e-3).astype(np.float16), g)
+    head = quant.EschaQ8Head(packed, scales, biases, g)
+    assert head._row_scales is not grouped
+    monkeypatch.setenv("ESCHA_MLX_Q8_HEAD", flag)
+    x = mx.array(rng.standard_normal((1, rows, k)).astype(np.float16))
+    full = head(x)
+    for prefix in (8, 128, 299):
+        got = head.prefix_logits(x, prefix)
+        mx.eval(full, got)
+        assert got.shape == (1, rows, prefix)
+        assert bool((got.view(mx.uint16) == full[..., :prefix].view(mx.uint16)).all()), (rows, flag, prefix)
