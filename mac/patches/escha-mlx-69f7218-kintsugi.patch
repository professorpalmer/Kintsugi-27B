+    for pf in (2, 8):
+        monkeypatch.setenv("ESCHA_MLX_DENSE_PF", str(pf))
+        g0, g1 = (np.array(v) for v in dense.project_pair(a, b, x))
+        assert np.array_equal(g0, r0) and np.array_equal(g1, r1), f"m={m} pf={pf}"
+    assert seen == ([1, 2, 8] if m == 1 else [1, 1, 1])
