+    s = rng.uniform(0.001, 0.01, (M, K // BK)).astype(np.float32)
+    got = np.array(g8.gemm_i8_blocked(mx.array(a), mx.array(b), mx.array(s), BK))
+    ab = a.astype(np.int64).reshape(M, K // BK, BK)
+    bb = b.astype(np.int64).reshape(K // BK, BK, N)
+    want = np.einsum("mkb,kbn->mkn", ab, bb).astype(np.float64)
+    want = (want * s[:, :, None]).sum(1) / 32.0
+    assert np.allclose(got, want, rtol=1e-5, atol=1e-5)
