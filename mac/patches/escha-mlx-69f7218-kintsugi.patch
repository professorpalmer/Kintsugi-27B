+
+@needs_metal
+@pytest.mark.recon
+@pytest.mark.parametrize("K", [2, 3])
+def test_recon_path_runs_and_is_close_to_exact(K, monkeypatch):
+    import mlx.core as mx
+    from escha_mlx import dense
+
+    g = _synth(K, np.random.default_rng(40 + K), 256, 2048)
+    x = mx.array((np.random.default_rng(3).standard_normal((128, 256)) * 0.4).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_RECON", "0")
+    exact = np.array(dense.build(g)(x)).astype(np.float32)
+    monkeypatch.setenv("ESCHA_MLX_DENSE_RECON", "64")
+    monkeypatch.setenv("ESCHA_MLX_DENSE_INT8", "off")
+    from escha_mlx import int8_gemm
+    lin = dense.build(g)
+    assert lin._recon(128) and not lin._recon(63) and not lin._recon(1)
+    fast = np.array(lin(x)).astype(np.float32)
+    rel = np.linalg.norm(fast - exact) / np.linalg.norm(exact)
+    assert rel < 2e-3, rel
+    # below the threshold the module takes the exact kernels
+    small = np.array(lin(x[:8])).astype(np.float32)
+    assert np.array_equal(small, exact[:8])
+
+
+@needs_metal
+@pytest.mark.recon
+def test_recon_off_with_zero(monkeypatch):
+    from escha_mlx import dense
