+# ---- per-group scales (Kintsugi-27B addition, 2026-11-20) ------------------------------------------------------
+
+def _grouped_fp16(w8: np.ndarray, group_scale: np.ndarray) -> np.ndarray:
+    """ESCHA_MLX_DENSE=fp16 form of a per-group tensor. NOT exact: f32(d) * w8 needs up to 18 bits."""
+    n, k = w8.shape
