index 0000000..c395670
--- /dev/null
+++ b/escha_mlx/int8_gemm.py
@@ -0,0 +1,390 @@
+"""int8 prefill GEMM on Apple GPU matrix units (Metal 4 MPP matmul2d), for ESCHA_MLX_DENSE_RECON.
+
+Same design as the Kintsugi CUDA engine's int8 prefill read (GGML_ESCHA_PREFILL=i8):
+  xh (f16, after the input Hadamard) -> int8, one scale per row: s = max|x| / 127       (quantize_rows_i8)
+  coded weight -> int8 = rint(w * 32); decoded trellis weights lie in +-3.95, so none clip (decode_i8)
+  int8 x int8 -> int32 on the matrix units; the epilogue writes mid = acc * s / 32 as f32 (gemm_i8_scaled)
+
+Measured on an M5 Max (40 cores, applegpu_g17s), 2048 x 5120 x 17408: MPP f16 61.5 TFLOPS, int8 114.8 TOPS.
+In the Qwen3.8-27B model at 4k tokens, chunk 2048: 1,308 tok/s against 757-825 for the f16 GEMM path.
+KL on 24 golden documents: +0.76 % against the exact path at prefill step 2048 (CUDA int8: +0.75 %), but +1.1 %
+at step 256 (ratio 1.0112, gate 1.01). That per-row form stays off (ESCHA_MLX_DENSE_INT8_BK=0).
+Error sources, per dot product: weight rounding rint(32 w) 0.73 % rel rms, per-row int8 activations 0.9-2.1 %.
+Not bit-identical by design.
+
+Default (2026-11-22): one activation scale per row and 256-wide K block (gemm_i8_blocked, the block scales in
+threadgroup memory, tile 64 x 64, 4 simdgroups), K and V projections (OC 1024) and the first and last 4 decoder
+layers on f16 (ESCHA_MLX_DENSE_INT8_EDGE). 100 golden documents: KL +0.152 % at step 2048, +0.159 % at step 128
+(upper 95 % bounds +0.285 % and +0.271 %, line +0.5 %). Prefill against f16 on M5 Max 40 cores: 1.33x at 8k and
+1.27x at 32k (step 2048), 1.43x at 6k (step 128). All layers in int8 fails the gate (+0.378 %, upper +0.532 %).
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-20 (changed 2026-11-22).
+"""
+from __future__ import annotations
+
+import re
+from functools import lru_cache
+
+import mlx.core as mx
+
+from . import envs, msl
+
+W_SCALE = 32.0
+TILE = (128, 64, 4)          # bm, bn, simdgroups: measured best of 64x32, 64x64, 128x64, 128x128 on M5 Max
+
+_HEADER = msl._HEADER + """
+#include <metal_tensor>
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+"""
+
+
+def _decode_i8_source(K: int, lut: bool) -> str:
+    wpt = 8 * K
+    extract = msl._substitute_fetch(msl._EXTRACT_K2 if K == 2 else msl._EXTRACT_K3)
+    stores = []
+    for j in range(8):
+        fi = j >> 1
+        row = f"(lane & 3u) * 2u + {j & 1}u + {(fi & 1) * 8}u"
+        col = f"2u * ((l0 >> 3) + {4 if j >= 4 else 0}u) + c_off"
+        val = msl._dec(f"s{j}", lut)
+        stores.append(f"    t[({row}) * 16u + {col}] = (char)rint((float)({val}) * {W_SCALE}f);")
+    return f"""
+    threadgroup char tg[{msl.DECODE_ROWS_SG} * 256];
+    uint lane = thread_position_in_threadgroup.x;
+    uint sg = thread_position_in_threadgroup.y;
+    uint nt = thread_position_in_grid.y;
+    uint kt = thread_position_in_grid.z;
+    threadgroup char* t = tg + sg * 256u;
+    device const uint* wp = code + ((ulong)kt * TN + nt) * {wpt}u;
+{extract}
+    uint l0 = lane & ~4u;
+    uint c_off = (lane >> 2) & 1u;
+{chr(10).join(stores)}
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane < 16u) {{
+        threadgroup const uint4* src = (threadgroup const uint4*)(t + lane * 16u);
+        device uint4* dst = (device uint4*)(w + ((ulong)(kt * 16u + lane)) * OC + nt * 16u);
+        *dst = *src;
+    }}
+"""
+
+
+@lru_cache(maxsize=None)
+def _decode_i8_kernel(K: int, lut: bool):
+    return mx.fast.metal_kernel(
+        name=f"escha_decode_i8_k{K}{'_lut' if lut else ''}",
+        input_names=["code"] + (["lut"] if lut else []),
+        output_names=["w"], header=msl._HEADER, source=_decode_i8_source(K, lut))
+
+
+def decode_i8(code_u32: mx.array, K: int, IC: int, OC: int) -> mx.array:
+    """Coded stream -> int8 [IC, OC] = rint(decode * 32). Needs OC / 16 to be a multiple of 8."""
+    tk, tn = IC // 16, OC // 16
+    lut = msl.use_lut()
+    (w,) = _decode_i8_kernel(K, lut)(
+        inputs=[code_u32.reshape(-1)] + ([msl._lut_array()] if lut else []),
+        template=[("TN", tn), ("OC", OC)], grid=(32, tn, tk), threadgroup=(32, msl.DECODE_ROWS_SG, 1),
+        output_shapes=[(IC, OC)], output_dtypes=[mx.int8])
+    return w
+
+
+_QUANT_SRC = """
+    uint r = threadgroup_position_in_grid.y;
+    uint tid = thread_position_in_threadgroup.x;
+    uint lane = thread_index_in_simdgroup;
+    uint sgi = simdgroup_index_in_threadgroup;
+    threadgroup float red[8];
+    device const half* row = x + (ulong)r * IC;
+    float m = 0.0f;
+    for (uint j = tid * 4u; j < IC; j += 1024u) {
+        half4 v = *(device const half4*)(row + j);
+        m = max(m, max(max(abs((float)v.x), abs((float)v.y)), max(abs((float)v.z), abs((float)v.w))));
+    }
+    m = simd_max(m);
+    if (lane == 0u) red[sgi] = m;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgi == 0u) {
+        float t = lane < 8u ? red[lane] : 0.0f;
+        t = simd_max(t);
+        if (lane == 0u) red[0] = max(t, 1e-8f);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float sc = red[0] / 127.0f;
+    float inv = 127.0f / red[0];
+    if (tid == 0u) s[r] = sc;
+    device int8_t* qrow = xq + (ulong)r * IC;
+    for (uint j = tid * 4u; j < IC; j += 1024u) {
+        half4 v = *(device const half4*)(row + j);
+        char4 o = char4(rint(float4(v) * inv));
+        *(device char4*)((device char*)qrow + j) = o;
+    }
+"""
+
+
+@lru_cache(maxsize=None)
+def _quant_kernel():
+    return mx.fast.metal_kernel(name="escha_quant_rows_i8", input_names=["x"], output_names=["xq", "s"],
+                                source=_QUANT_SRC)
+
+
+def quantize_rows_i8(xh: mx.array):
+    """f16 [M, IC] -> (int8 [M, IC], f32 scale [M]) with one scale per row."""
+    M, IC = xh.shape
+    xq, s = _quant_kernel()(inputs=[xh.astype(mx.float16)], template=[("IC", IC)],
+                            grid=(256, M, 1), threadgroup=(256, 1, 1),
+                            output_shapes=[(M, IC), (M,)], output_dtypes=[mx.int8, mx.float32])
+    return xq, s
+
+
+def _gemm_epi_source(bm: int, bn: int, sg: int) -> str:
+    return f"""
+    constexpr auto desc = matmul2d_descriptor({bm}, {bn}, static_cast<int>(dynamic_extent), false, false, true);
+    matmul2d<desc, execution_simdgroups<{sg}>> op;
+    tensor<device int8_t, dextents<int32_t, 2>, tensor_inline> A((device int8_t*)a, dextents<int32_t, 2>(K, M));
+    tensor<device int8_t, dextents<int32_t, 2>, tensor_inline> B((device int8_t*)b, dextents<int32_t, 2>(N, K));
+    uint m0 = threadgroup_position_in_grid.y * {bm};
+    uint n0 = threadgroup_position_in_grid.x * {bn};
+    auto mA = A.slice(0, m0);
+    auto mB = B.slice(n0, 0);
+    auto cT = op.template get_destination_cooperative_tensor<decltype(mA), decltype(mB), int32_t>();
+    #pragma unroll
+    for (uint16_t i = 0; i < cT.get_capacity(); ++i) {{
+        if (cT.is_valid_element(i)) cT[i] = 0;
+    }}
+    op.run(mA, mB, cT);
+    #pragma unroll
+    for (uint16_t i = 0; i < cT.get_capacity(); ++i) {{
+        if (cT.is_valid_element(i)) {{
+            auto idx = cT.get_multidimensional_index(i);
+            uint n = n0 + idx[0];
+            uint m = m0 + idx[1];
+            if (m < M && n < N) c[(ulong)m * N + n] = (float)cT[i] * sx[m] * {1.0 / W_SCALE}f;
+        }}
+    }}
+"""
+
+
+@lru_cache(maxsize=None)
+def _gemm_epi_kernel(bm: int, bn: int, sg: int):
+    return mx.fast.metal_kernel(
+        name=f"escha_i8gemm_epi_{bm}_{bn}_{sg}", input_names=["a", "b", "sx"], output_names=["c"],
+        header=_HEADER, source=_gemm_epi_source(bm, bn, sg))
+
+
+def gemm_i8_scaled(xq: mx.array, wq: mx.array, sx: mx.array, tile=TILE) -> mx.array:
+    bm, bn, sg = tile
+    M, K = xq.shape
+    N = wq.shape[1]
+    (c,) = _gemm_epi_kernel(bm, bn, sg)(
+        inputs=[xq, wq, sx], template=[("M", M), ("N", N), ("K", K)],
+        grid=(((N + bn - 1) // bn) * 32 * sg, (M + bm - 1) // bm, 1), threadgroup=(32 * sg, 1, 1),
+        output_shapes=[(M, N)], output_dtypes=[mx.float32])
+    return c
+
+
+_QUANT_BLK_SRC = """
+    uint kb = threadgroup_position_in_grid.x;
+    uint r = threadgroup_position_in_grid.y;
+    uint tid = thread_position_in_threadgroup.x;
+    uint lane = thread_index_in_simdgroup;
+    uint sgi = simdgroup_index_in_threadgroup;
+    threadgroup float red[8];
+    ulong off = (ulong)r * IC + kb * BK + tid * 4u;
+    float4 f = float4(*(device const half4*)(x + off));
+    float m = simd_max(max(max(abs(f.x), abs(f.y)), max(abs(f.z), abs(f.w))));
+    if (lane == 0u) red[sgi] = m;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float t = red[0];
+    for (uint i = 1u; i < NSG; ++i) t = max(t, red[i]);
+    t = max(t, 1e-8f);
+    if (tid == 0u) s[(ulong)r * NKB + kb] = t / 127.0f;
+    *(device char4*)((device char*)xq + off) = char4(rint(f * (127.0f / t)));
+"""
+
+
+@lru_cache(maxsize=None)
+def _quant_blk_kernel():
+    return mx.fast.metal_kernel(name="escha_quant_blocks_i8", input_names=["x"], output_names=["xq", "s"],
+                                source=_QUANT_BLK_SRC)
+
+
+def quantize_blocks_i8(xh: mx.array, bk: int):
+    """f16 [M, IC] -> (int8 [M, IC], f32 scale [M, IC / bk]): one scale per row and K block of bk."""
+    M, IC = xh.shape
+    nkb, nt = IC // bk, bk // 4
+    xq, s = _quant_blk_kernel()(inputs=[xh.astype(mx.float16)],
+                                template=[("IC", IC), ("BK", bk), ("NKB", nkb), ("NSG", (nt + 31) // 32)],
+                                grid=(nt * nkb, M, 1), threadgroup=(nt, 1, 1),
+                                output_shapes=[(M, IC), (M, nkb)], output_dtypes=[mx.int8, mx.float32])
+    return xq, s
+
+
+def _gemm_blk_tg_source(bm: int, bn: int, sg: int, bk: int) -> str:
+    """Per-K-block scales: the tile's scales [bm x NKB] go to threadgroup memory once, each element's row offset is
+    computed once, and the tile is 64 x 64 so the int32 and f32 accumulators stay in registers. Measured on M5 Max
+    (2048 x 5120 x 17408, BK 256): 3.94 ms against 12.93 ms for _gemm_blk_source and 6.11 ms for the f16 GEMM.
+    The output is equal, bit for bit (test_gemm_blocked_tg_equals_plain)."""
+    cap = bm * bn // (32 * sg)
+    return f"""
+    constexpr auto desc = matmul2d_descriptor({bm}, {bn}, {bk}, false, false, true);
+    matmul2d<desc, execution_simdgroups<{sg}>> op;
+    tensor<device int8_t, dextents<int32_t, 2>, tensor_inline> A((device int8_t*)a, dextents<int32_t, 2>(K, M));
+    tensor<device int8_t, dextents<int32_t, 2>, tensor_inline> B((device int8_t*)b, dextents<int32_t, 2>(N, K));
+    uint m0 = threadgroup_position_in_grid.y * {bm};
+    uint n0 = threadgroup_position_in_grid.x * {bn};
+    threadgroup float ss[{bm} * NKB];
+    for (uint t = thread_index_in_threadgroup; t < {bm}u * NKB; t += {32 * sg}u) {{
+        uint r = t / NKB, kb = t % NKB;
+        ss[t] = (m0 + r) < M ? sx[(ulong)(m0 + r) * NKB + kb] : 0.0f;
+    }}
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    auto mA = A.slice(0, m0);
+    auto mB = B.slice(n0, 0);
+    auto cT = op.template get_destination_cooperative_tensor<decltype(mA), decltype(mB), int32_t>();
+    auto fT = op.template get_destination_cooperative_tensor<decltype(mA), decltype(mB), float>();
+    constexpr uint16_t CAP = {cap};
+    uint ro[CAP];
+    #pragma unroll
+    for (uint16_t i = 0; i < CAP; ++i) {{
+        if (i >= cT.get_capacity()) continue;
+        if (fT.is_valid_element(i)) fT[i] = 0.0f;
+        ro[i] = cT.is_valid_element(i) ? (uint)(cT.get_multidimensional_index(i)[1]) * NKB : 0;
+    }}
+    for (uint kb = 0; kb < NKB; ++kb) {{
+        #pragma unroll
+        for (uint16_t i = 0; i < CAP; ++i) {{
+            if (i < cT.get_capacity() && cT.is_valid_element(i)) cT[i] = 0;
+        }}
+        auto sA = A.slice(int(kb * {bk}u), m0);          // run() takes lvalues of the same types as mA, mB
+        auto sB = B.slice(n0, int(kb * {bk}u));
+        op.run(sA, sB, cT);
+        #pragma unroll
+        for (uint16_t i = 0; i < CAP; ++i) {{
+            if (i < cT.get_capacity() && cT.is_valid_element(i)) fT[i] += (float)cT[i] * ss[ro[i] + kb];
+        }}
+    }}
+    #pragma unroll
+    for (uint16_t i = 0; i < CAP; ++i) {{
+        if (i < fT.get_capacity() && fT.is_valid_element(i)) {{
+            auto idx = fT.get_multidimensional_index(i);
+            uint n = n0 + idx[0];
+            uint m = m0 + idx[1];
+            if (m < M && n < N) c[(ulong)m * N + n] = fT[i] * {1.0 / W_SCALE}f;
+        }}
+    }}
+"""
+
+
+def _gemm_blk_source(bm: int, bn: int, sg: int, bk: int) -> str:
+    return f"""
+    constexpr auto desc = matmul2d_descriptor({bm}, {bn}, {bk}, false, false, true);
+    matmul2d<desc, execution_simdgroups<{sg}>> op;
+    tensor<device int8_t, dextents<int32_t, 2>, tensor_inline> A((device int8_t*)a, dextents<int32_t, 2>(K, M));
+    tensor<device int8_t, dextents<int32_t, 2>, tensor_inline> B((device int8_t*)b, dextents<int32_t, 2>(N, K));
+    uint m0 = threadgroup_position_in_grid.y * {bm};
+    uint n0 = threadgroup_position_in_grid.x * {bn};
+    auto mA = A.slice(0, m0);
+    auto mB = B.slice(n0, 0);
+    auto cT = op.template get_destination_cooperative_tensor<decltype(mA), decltype(mB), int32_t>();
+    auto fT = op.template get_destination_cooperative_tensor<decltype(mA), decltype(mB), float>();
+    #pragma unroll
+    for (uint16_t i = 0; i < fT.get_capacity(); ++i) {{
+        if (fT.is_valid_element(i)) fT[i] = 0.0f;
+    }}
+    for (uint kb = 0; kb < NKB; ++kb) {{
+        #pragma unroll
+        for (uint16_t i = 0; i < cT.get_capacity(); ++i) {{
+            if (cT.is_valid_element(i)) cT[i] = 0;
+        }}
+        auto sA = A.slice(int(kb * {bk}u), m0);          // run() takes lvalues of the same types as mA, mB
+        auto sB = B.slice(n0, int(kb * {bk}u));
+        op.run(sA, sB, cT);
+        #pragma unroll
+        for (uint16_t i = 0; i < cT.get_capacity(); ++i) {{
+            if (cT.is_valid_element(i)) {{
+                uint m = m0 + cT.get_multidimensional_index(i)[1];
+                float sc = m < M ? sx[(ulong)m * NKB + kb] : 0.0f;
+                fT[i] += (float)cT[i] * sc;
+            }}
+        }}
+    }}
+    #pragma unroll
+    for (uint16_t i = 0; i < fT.get_capacity(); ++i) {{
+        if (fT.is_valid_element(i)) {{
+            auto idx = fT.get_multidimensional_index(i);
+            uint n = n0 + idx[0];
+            uint m = m0 + idx[1];
+            if (m < M && n < N) c[(ulong)m * N + n] = fT[i] * {1.0 / W_SCALE}f;
+        }}
+    }}
+"""
+
+
+@lru_cache(maxsize=None)
+def _gemm_blk_kernel(bm: int, bn: int, sg: int, bk: int, tg: bool = False):
+    src = _gemm_blk_tg_source if tg else _gemm_blk_source
+    return mx.fast.metal_kernel(
+        name=f"escha_i8gemm_blk{'tg' if tg else ''}_{bm}_{bn}_{sg}_{bk}", input_names=["a", "b", "sx"],
+        output_names=["c"], header=_HEADER, source=src(bm, bn, sg, bk))
+
+
+BLK_TILE = (64, 64, 4)        # with the threadgroup scales; larger tiles spill (13-30 ms at the shape above)
+
+
+def gemm_i8_blocked(xq: mx.array, wq: mx.array, sx: mx.array, bk: int, tile=None) -> mx.array:
+    """f32 [M, N] = sum over K blocks of (xq_blk @ wq_blk) * sx[:, blk] / W_SCALE."""
+    M, K = xq.shape
+    N = wq.shape[1]
+    tg = tile is None and BLK_TILE[0] * (K // bk) * 4 <= 32768       # the scales must fit in threadgroup memory
+    bm, bn, sg = BLK_TILE if tg else (tile or TILE)
+    (c,) = _gemm_blk_kernel(bm, bn, sg, bk, tg)(
+        inputs=[xq, wq, sx], template=[("M", M), ("N", N), ("K", K), ("NKB", K // bk)],
+        grid=(((N + bn - 1) // bn) * 32 * sg, (M + bm - 1) // bm, 1), threadgroup=(32 * sg, 1, 1),
+        output_shapes=[(M, N)], output_dtypes=[mx.float32])
+    return c
+
+
+def supports(IC: int, OC: int) -> bool:
+    # OC < 2048 (the K and V projections, 1024): the int8 GEMM was slower than f16 there (0.75x, speedlab q56)
+    return IC % 4 == 0 and (OC // 16) % msl.DECODE_ROWS_SG == 0 and OC >= 2048
+
+
+def matmul_i8(xh: mx.array, code_u32: mx.array, K: int, IC: int, OC: int) -> mx.array:
+    """mid (f32 [M, OC]) = xh @ decode(code), through int8 on the matrix units."""
+    bk = envs.ESCHA_MLX_DENSE_INT8_BK.get()
+    if bk and IC % bk == 0 and bk in (128, 256, 512, 1024):
+        xq, s = quantize_blocks_i8(xh, bk)
+        return gemm_i8_blocked(xq, decode_i8(code_u32, K, IC, OC), s, bk)
+    xq, s = quantize_rows_i8(xh)
+    return gemm_i8_scaled(xq, decode_i8(code_u32, K, IC, OC), s)
+
+
+def _gpu_generation() -> int:
+    m = re.search(r"g(\d+)", str(mx.device_info().get("architecture", "")))
+    return int(m.group(1)) if m else 0
+
+
+def enabled() -> bool:
+    """ESCHA_MLX_DENSE_INT8: auto = on for GPUs with matrix units (applegpu_g17, M5, and later) when the MPP
+    kernels build and give the right answer on a small case; on / off force it. The env var is read on every
+    call; only the GPU check is cached (per mode)."""
+    return _works(envs.ESCHA_MLX_DENSE_INT8.get())
+
+
+@lru_cache(maxsize=None)
+def _works(mode: str) -> bool:
+    if mode == "off":
+        return False
+    if mode == "auto" and _gpu_generation() < 17:
+        return False
+    try:
+        xq = mx.ones((128, 64), dtype=mx.int8)
+        wq = mx.ones((64, 128), dtype=mx.int8)
+        c = gemm_i8_scaled(xq, wq, mx.full((128,), 2.0, dtype=mx.float32))
+        ok = bool(mx.all(c == 64 * 2.0 / W_SCALE).item())
+    except Exception:  # noqa: BLE001 -- no Metal 4 / MPP: use the f16 GEMM
+        ok = False
+    if not ok and mode == "on":
+        raise RuntimeError("ESCHA_MLX_DENSE_INT8=on, but the MPP int8 GEMM does not build or is wrong here")
+    return ok
