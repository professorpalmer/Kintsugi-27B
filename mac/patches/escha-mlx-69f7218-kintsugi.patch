+
+@needs_metal
+@pytest.mark.parametrize("m", [1, 4])
+def test_pf_pair_kernel_is_bit_identical(monkeypatch, m):
+    """The pair kernel is built from the same body and takes pf at one row (with ESCHA_MLX_DENSE_PAIR_M1). A spy
+    shows which pf each pair-kernel build got, so the m=1 case cannot pass on the one-tile kernel alone."""
+    import mlx.core as mx
+    from escha_mlx import dense, msl
+    seen = []
+    real = msl._dense_gemm_pair_out_kernel
+
+    def spy(K0, K1, lut, R, rs, pf=1):
+        seen.append(pf)
+        return real(K0, K1, lut, R, rs, pf)
+
+    monkeypatch.setattr(msl, "_dense_gemm_pair_out_kernel", spy)
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PAIR_M1", "1")
+    a, b = _linear(2, 512, 512, 11), _linear(3, 512, 256, 12)
+    assert a._pair_m1 and b._pair_m1
+    x = mx.array(np.random.default_rng(m).standard_normal((1, m, 512)).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PF", "1")
