--- /dev/null
+++ b/tests/test_kintsugi_flash.py
@@ -0,0 +1,125 @@
+"""Fused flash attention for head dim 256 (escha_mlx.flash_attn) and its use in Qwen3.5 attention.
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-21.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal
+
+pytestmark = [needs_metal, pytest.mark.flash]
+
+
+def _flash_or_skip():
+    from escha_mlx import flash_attn
+    if not flash_attn.enabled():
+        pytest.skip("no MPP flash attention on this GPU")
+    return flash_attn
+
+
+def _ref32(q, k, v, causal):
+    import mlx.core as mx
+    HQ, HKV, L, S = q.shape[1], k.shape[1], q.shape[2], k.shape[2]
+    kk = mx.repeat(k, HQ // HKV, axis=1).astype(mx.float32)
+    vv = mx.repeat(v, HQ // HKV, axis=1).astype(mx.float32)
+    s = (q.astype(mx.float32) @ kk.swapaxes(-1, -2)) * 256 ** -0.5
+    if causal:
+        qi = mx.arange(L)[:, None] + (S - L)
+        s = mx.where(mx.arange(S)[None] <= qi, s, -mx.inf)
+    return mx.softmax(s, axis=-1) @ vv
+
+
+def _qkv(L, S, HQ=12, HKV=2, seed=0):
+    import mlx.core as mx
+    rng = np.random.default_rng(seed)
+    f = lambda *sh: mx.array(rng.standard_normal(sh).astype(np.float16))  # noqa: E731
+    return f(1, HQ, L, 256), f(1, HKV, S, 256), f(1, HKV, S, 256)
+
+
+@pytest.mark.parametrize("L,S", [(16, 16), (64, 64), (100, 300), (512, 4133), (33, 2000)])
+@pytest.mark.parametrize("causal", [True, False])
+@pytest.mark.parametrize("cfg", [dict(), dict(GH=6, RB=1, DB=False), dict(BK=16, GH=2, RB=1, DB=True)])
+def test_flash_matches_f32_reference(L, S, causal, cfg):
+    import mlx.core as mx
+    fa = _flash_or_skip()
+    q, k, v = _qkv(L, S, HQ=12, HKV=2, seed=L + S)
+    got = fa.flash_attention(q, k, v, 256 ** -0.5, causal, **cfg).astype(mx.float32)
+    err = float(mx.abs(got - _ref32(q, k, v, causal)).max())
+    assert err < 4e-3, err
+
+
+def test_flash_reads_strided_views():
+    """K/V as slices of a larger (reserved) buffer and q as a transposed view give the same result."""
+    import mlx.core as mx
+    fa = _flash_or_skip()
+    q, k, v = _qkv(200, 1000, seed=7)
+    want = fa.flash_attention(q, k, v, 256 ** -0.5, True)
+    kb = mx.zeros((1, 2, 1040, 256), mx.float16)
+    vb = mx.zeros((1, 2, 1040, 256), mx.float16)
+    kb[:, :, :1000] = k
+    vb[:, :, :1000] = v
+    qv = (q.transpose(0, 2, 1, 3) + 0).transpose(0, 2, 1, 3)
+    got = fa.flash_attention(qv, kb[:, :, :1000], vb[:, :, :1000], 256 ** -0.5, True)
+    assert mx.array_equal(got, want)
+
+
+def test_attention_uses_flash_for_head_dim_256(monkeypatch):
+    import mlx.core as mx
+    from escha_mlx.models import qwen3_5
+    fa = _flash_or_skip()
+    calls = []
+    real = fa.flash_attention
+    monkeypatch.setattr(fa, "flash_attention", lambda *a, **kw: calls.append(1) or real(*a, **kw))
+    q, k, v = _qkv(64, 300, seed=3)
+    got = qwen3_5._attention(q, k, v, None, 256 ** -0.5, "causal").astype(mx.float32)
+    assert calls == [1]
+    assert float(mx.abs(got - _ref32(q, k, v, True)).max()) < 4e-3
+
+
+def test_off_keeps_sdpa(monkeypatch):
+    from escha_mlx import flash_attn
+    from escha_mlx.models import qwen3_5
+    monkeypatch.setenv("ESCHA_MLX_ATTN_FLASH", "off")
+    monkeypatch.setattr(flash_attn, "flash_attention", lambda *a, **kw: pytest.fail("flash used while off"))
+    q, k, v = _qkv(64, 300, seed=4)
+    qwen3_5._attention(q, k, v, None, 256 ** -0.5, "causal")
+
+
+@pytest.mark.parametrize("L,S,HQ,HKV", [(16, 16, 12, 2), (64, 64, 12, 2), (100, 300, 12, 2), (512, 4133, 12, 2),
+                                        (33, 2000, 12, 2), (2048, 32768, 24, 4)])
+@pytest.mark.parametrize("causal", [True, False])
+def test_flash_matches_blocked_path(L, S, HQ, HKV, causal, monkeypatch):
+    """flash_attention against #4's query-blocked SDPA (_attention with flash off and a 1 MB score budget)."""
+    import mlx.core as mx
+    from escha_mlx import flash_attn
+    from escha_mlx.models import qwen3_5
+    fa = _flash_or_skip()
+    q, k, v = _qkv(L, S, HQ=HQ, HKV=HKV, seed=L * 7 + S)
+    got = fa.flash_attention(q, k, v, 256 ** -0.5, causal).astype(mx.float32)
+    monkeypatch.setenv("ESCHA_MLX_ATTN_FLASH", "off")
+    monkeypatch.setenv("ESCHA_MLX_ATTN_SCORE_MB", "1")
+    want = qwen3_5._attention(q, k, v, None, 256 ** -0.5, "causal" if causal else None).astype(mx.float32)
+    err = float(mx.abs(got - want).max())
+    print(f"flash vs blocked L={L} S={S} causal={causal}: max abs {err:.2e}")
+    assert err < 4e-3, err
+
+
+def test_default_is_auto(monkeypatch):
+    """Paired 100-document KL gate passed at prefill steps 2048 and 128: the default is auto (M5 and later)."""
+    from escha_mlx import envs, flash_attn
+    from escha_mlx.int8_gemm import _gpu_generation
+    monkeypatch.delenv("ESCHA_MLX_ATTN_FLASH", raising=False)
+    assert envs.ESCHA_MLX_ATTN_FLASH.get() == "auto"
+    # M5 and later: the default must really turn flash on (the kernel builds and passes its self-check)
+    assert flash_attn.enabled() is (_gpu_generation() >= 17)
+
+
+def test_env_change_applies_without_cache_clear(monkeypatch):
+    from escha_mlx import flash_attn
+    fa = _flash_or_skip()
+    monkeypatch.setenv("ESCHA_MLX_ATTN_FLASH", "off")
+    assert fa.enabled() is False
+    monkeypatch.setenv("ESCHA_MLX_ATTN_FLASH", "auto")
+    assert fa.enabled() is True
