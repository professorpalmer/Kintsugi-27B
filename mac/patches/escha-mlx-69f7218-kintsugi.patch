+"""Decode-once dense GEMM (ESCHA_MLX_DENSE_RECON).
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-20.
+"""
+from __future__ import annotations
+
+import numpy as np
