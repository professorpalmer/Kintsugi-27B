+"""Gate ESCHA_MLX_DENSE_V4: the small-row direct GEMM with fused output transform loads code words 16 bytes per lane
+into threadgroup memory, and each lane reads its two words of a tile from there.
+
+Contract: only the load path changes. Extract, decode, the kt summation order and the epilogue are the same, so the
+f16 output is BIT-IDENTICAL to the scalar-load kernel, at 1, 2 and 4 rows, for both code rates, with and without the
+decode LUT, in the single and the pair kernel.
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-21.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal, needs_mlx
+
+
+def _linear(K: int, IC: int, OC: int, seed: int, bias: bool = False):
+    from escha_mlx import dense
+    rng = np.random.default_rng(seed)
+    code = rng.integers(-2**15, 2**15, size=(IC // 16, OC // 16, 16 * K), dtype=np.int64).astype(np.int16)
+    rin = (rng.random(IC) + 0.5).astype(np.float16)
+    rout = (rng.random(OC) + 0.5).astype(np.float16)
+    b = (rng.standard_normal(OC) * 0.1).astype(np.float16) if bias else None
+    return dense.EschaLinear(dense.EschaWeight(code, rin, rout), bias=b)
+
+
+@needs_metal
+@pytest.mark.parametrize("K", [2, 3])
+@pytest.mark.parametrize("IC,OC", [(256, 512), (1024, 256), (640, 384)])
+@pytest.mark.parametrize("m", [1, 2, 3, 4, 5])
+def test_v4_is_bit_identical_to_scalar_loads(monkeypatch, K, IC, OC, m):
+    """m=3 runs an R=2 group and an R=1 group; m=5 an R=4 group and an R=1 group."""
+    import mlx.core as mx
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    lin = _linear(K, IC, OC, K * 1000 + IC + OC + m, bias=(m == 3))
+    x = mx.array(np.random.default_rng(m + IC).standard_normal((1, m, IC)).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "0")
+    ref = np.array(lin(x))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "1")
+    assert np.array_equal(np.array(lin(x)), ref), f"K={K} {IC}x{OC} m={m}"
+
+
+@needs_metal
+@pytest.mark.parametrize("K", [2, 3])
+def test_v4_is_bit_identical_with_lut(monkeypatch, K):
+    import mlx.core as mx
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    monkeypatch.setenv("ESCHA_MLX_LUT", "1")
+    lin = _linear(K, 512, 256, 77 + K)
+    for m in (1, 2, 4):
+        x = mx.array(np.random.default_rng(m).standard_normal((1, m, 512)).astype(np.float16))
+        monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "0")
+        ref = np.array(lin(x))
+        monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "1")
+        assert np.array_equal(np.array(lin(x)), ref), f"K={K} m={m}"
+
+
+@needs_metal
+def test_v4_really_builds_the_staged_kernel(monkeypatch):
+    """Guard against a vacuous equality: record (R, pf, v4) of every single-kernel build."""
+    import mlx.core as mx
+    from escha_mlx import msl
+    seen = []
+    real = msl._dense_gemm_rows_direct_out_kernel
+
+    def spy(K, lut, R, rs, pf=1, v4=False):
+        seen.append((R, pf, v4))
+        return real(K, lut, R, rs, pf, v4)
+
+    monkeypatch.setattr(msl, "_dense_gemm_rows_direct_out_kernel", spy)
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "1")
+    lin = _linear(2, 256, 512, 4)
+    for m in (1, 2, 4, 8):
+        mx.eval(lin(mx.array(np.ones((1, m, 256), dtype=np.float16))))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "0")
+    mx.eval(lin(mx.array(np.ones((1, 1, 256), dtype=np.float16))))
+    assert seen == [(1, 8, True), (2, 8, True), (4, 4, True), (8, 1, False), (1, 8, False)]
+
+
+
+@needs_mlx
+def test_v4_batch_always_divides_a_legal_shape():
+    """EschaLinear accepts only dimensions that are multiples of 128, so IC // 16 is a multiple of 8 and the pf 8 and
+    pf 4 batches always divide it: the scalar fallback in dense_v4_pf cannot be reached by a model linear."""
+    from escha_mlx import msl
+    for IC in range(128, 32768 + 1, 128):
+        assert [msl.dense_v4_pf(R, IC) for R in (1, 2, 4)] == [8, 8, 4], IC
+    with pytest.raises(ValueError, match="multiples of 128"):
+        _linear(2, 192, 256, 5)
+
+
+@needs_metal
+@pytest.mark.parametrize("lut", ["0", "1"])
+@pytest.mark.parametrize("m", [1, 2, 4])
+def test_v4_pair_kernel_is_bit_identical(monkeypatch, m, lut):
+    """project_pair runs the pair kernel at 2 and 4 rows, and at 1 row with ESCHA_MLX_DENSE_PAIR_M1; with V4 it is
+    built from the staged shards. Both code rates, with and without the decode LUT."""
+    import mlx.core as mx
+    from escha_mlx import dense, msl
+    seen = []
+    real = msl._dense_gemm_pair_out_kernel
+
+    def spy(K0, K1, lut, R, rs, pf=1, v4=False):
+        seen.append(v4)
+        return real(K0, K1, lut, R, rs, pf, v4)
+
+    monkeypatch.setattr(msl, "_dense_gemm_pair_out_kernel", spy)
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PAIR_M1", "1")
+    monkeypatch.setenv("ESCHA_MLX_LUT", lut)
+    a, b = _linear(2, 512, 512, 11), _linear(3, 512, 256, 12)
+    assert a._pair_m1 and b._pair_m1
+    x = mx.array(np.random.default_rng(m).standard_normal((1, m, 512)).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "0")
+    r0, r1 = (np.array(t) for t in dense.project_pair(a, b, x))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "1")
+    g0, g1 = (np.array(t) for t in dense.project_pair(a, b, x))
+    assert np.array_equal(g0, r0) and np.array_equal(g1, r1)
+    assert seen == [False, True]
+
+
+@needs_mlx
+def test_v4_policy(monkeypatch):
+    from escha_mlx import msl
+    monkeypatch.delenv("ESCHA_MLX_DENSE_V4", raising=False)
+    assert [msl.dense_v4_pf(R, 5120) for R in (1, 2, 4, 8, 16)] == [8, 8, 4, 0, 0]    # default on
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "0")
+    assert msl.dense_v4_pf(1, 5120) == 0
+    monkeypatch.setenv("ESCHA_MLX_DENSE_V4", "maybe")
+    with pytest.raises(Exception):
+        msl.dense_v4_pf(1, 5120)
+
+
+@needs_mlx
+def test_mtp_async_every_parses(monkeypatch):
+    from escha_mlx import envs
+    monkeypatch.delenv("ESCHA_MLX_MTP_ASYNC_EVERY", raising=False)
+    assert envs.ESCHA_MLX_MTP_ASYNC_EVERY.get() == 4
+    for good in ("0", "1", "64"):
+        monkeypatch.setenv("ESCHA_MLX_MTP_ASYNC_EVERY", good)
+        assert envs.ESCHA_MLX_MTP_ASYNC_EVERY.get() == int(good)
+    for bad in ("-1", "65", "x"):
+        monkeypatch.setenv("ESCHA_MLX_MTP_ASYNC_EVERY", bad)
+        with pytest.raises(Exception):
+            envs.ESCHA_MLX_MTP_ASYNC_EVERY.get()
