+"""Query-blocked attention for head dims without a fused MLX kernel (ESCHA_MLX_ATTN_SCORE_MB).
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-20.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal
+
+
+@needs_metal
+@pytest.mark.parametrize("L,S", [(256, 256), (256, 4000), (100, 3000), (512, 513)])
+@pytest.mark.parametrize("mask", ["causal", None])
+def test_blocked_equals_unblocked(L, S, mask, monkeypatch):
+    import mlx.core as mx
+    from escha_mlx.models import qwen3_5
+
+    rng = np.random.default_rng(L + S)
+    q = mx.array(rng.standard_normal((1, 12, L, 256)).astype(np.float16))
+    k = mx.array(rng.standard_normal((1, 2, S, 256)).astype(np.float16))
+    v = mx.array(rng.standard_normal((1, 2, S, 256)).astype(np.float16))
+    want = mx.fast.scaled_dot_product_attention(q, k, v, scale=256 ** -0.5, mask=mask)
+    monkeypatch.setenv("ESCHA_MLX_ATTN_SCORE_MB", "1")          # 1 MB budget: many blocks
+    calls = []
+    real = mx.fast.scaled_dot_product_attention
+    monkeypatch.setattr(mx.fast, "scaled_dot_product_attention",
+                        lambda *a, **kw: calls.append(1) or real(*a, **kw))
+    got = qwen3_5._attention(q, k, v, None, 256 ** -0.5, mask)
+    assert len(calls) > 1
+    err = float(mx.abs(got.astype(mx.float32) - want.astype(mx.float32)).max())
+    assert err < 2e-3, err
+
+
+@needs_metal
+def test_plain_when_fused_dim_or_small(monkeypatch):
+    import mlx.core as mx
+    from escha_mlx.models import qwen3_5
+
+    calls = []
+    real = mx.fast.scaled_dot_product_attention
+    monkeypatch.setattr(mx.fast, "scaled_dot_product_attention",
+                        lambda *a, **kw: calls.append(1) or real(*a, **kw))
+    q = mx.zeros((1, 4, 64, 128), dtype=mx.float16)
+    k = mx.zeros((1, 2, 64, 128), dtype=mx.float16)
+    qwen3_5._attention(q, k, k, None, 0.1, "causal")
+    assert len(calls) == 1
+
+
+@needs_metal
+def test_blocked_transient_is_bounded(monkeypatch):
+    """The live set of the blocked path stays near two blocks, not all of them (review of #4: 259k swapped).
+    Old lazy loop on this shape: about 7 blocks alive (59 MB); now about 2 (17 MB); one block about 8.5 MB."""
+    import mlx.core as mx
+    from escha_mlx.models import qwen3_5
+    monkeypatch.setenv("ESCHA_MLX_ATTN_SCORE_MB", "8")            # rows = 8e6 / (12 * 4096 * 2) -> 64: 8 blocks
+    rng = np.random.default_rng(1)
+    q = mx.array(rng.standard_normal((1, 12, 512, 256)).astype(np.float16))
+    k = mx.array(rng.standard_normal((1, 2, 4096, 256)).astype(np.float16))
+    mx.eval(q, k)
+
+    def transient(fn):
+        mx.synchronize()
+        mx.clear_cache()
+        mx.reset_peak_memory()
+        base = mx.get_active_memory()
+        mx.eval(fn())
+        return mx.get_peak_memory() - base
+
+    one = transient(lambda: mx.fast.scaled_dot_product_attention(q[:, :, :64], k, k, scale=1 / 16, mask="causal"))
+    whole = transient(lambda: qwen3_5._attention(q, k, k, None, 1 / 16, "causal"))
+    assert whole < 3 * one, (whole, one)
