+@pytest.mark.parametrize("ic,oc", [(BIG_IC, BIG_OC), (256, 2048), (2048, 256)])
+def test_decode_rows_is_bit_identical_to_decode_tiles(K, ic, oc):
+    import mlx.core as mx
+    from escha_mlx import dense, msl
+
+    lin = dense.build(_synth(K, np.random.default_rng(7 + K), ic, oc))
+    w = lin._w
+    a = msl.decode_rows(w.code, w.K, w.IC, w.OC)
+    b = msl.decode_tiles(w.code, w.K, w.IC, w.OC)
+    assert np.array_equal(np.array(a.view(mx.uint16)), np.array(b.view(mx.uint16)))
