+"""GrowingKVCache equals mlx-lm KVCache in content; it grows geometrically and honors reserve().
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-20.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_mlx
+
+
+@needs_mlx
+@pytest.mark.parametrize("chunks", [[1, 1, 1], [300, 1, 1000, 7], [2048] * 5, [5, 256, 3]])
+@pytest.mark.parametrize("reserve", [0, 4096])
+def test_same_content_as_stock(chunks, reserve):
+    import mlx.core as mx
+    from mlx_lm.models.cache import KVCache
+    from escha_mlx.kv_cache import GrowingKVCache
+
+    rng = np.random.default_rng(len(chunks))
+    a, b = KVCache(), GrowingKVCache()
+    b.reserve(reserve)
+    for n in chunks:
+        k = mx.array(rng.standard_normal((1, 2, n, 8)).astype(np.float16))
+        v = mx.array(rng.standard_normal((1, 2, n, 8)).astype(np.float16))
+        ka, va = a.update_and_fetch(k, v)
+        kb, vb = b.update_and_fetch(k, v)
+        assert np.array_equal(np.array(ka), np.array(kb)) and np.array_equal(np.array(va), np.array(vb))
+    assert a.offset == b.offset
+    # trim keeps working (MTP rolls back rejected drafts)
+    a.trim(3); b.trim(3)
+    k = mx.ones((1, 2, 2, 8), dtype=mx.float16)
+    ka, _ = a.update_and_fetch(k, k)
+    kb, _ = b.update_and_fetch(k, k)
+    assert np.array_equal(np.array(ka), np.array(kb))
+
+
+@needs_mlx
+def test_growth_count_is_bounded_and_reserve_is_one():
+    import mlx.core as mx
+    from escha_mlx.kv_cache import GrowingKVCache
+
+    c = GrowingKVCache()                                  # default GROW_MAX 32768
+    caps = set()
+    for _ in range(128):
+        c.update_and_fetch(mx.zeros((1, 1, 2048, 4)), mx.zeros((1, 1, 2048, 4)))
+        caps.add(c.keys.shape[2])
+    # doubling 2048 -> 32768 (5 sizes), then +32768 steps up to 262144 (7 more): 12 growths, not 128
+    assert len(caps) <= 12
+    r = GrowingKVCache()
+    r.reserve(128 * 2048)
+    caps = set()
+    for _ in range(128):
+        r.update_and_fetch(mx.zeros((1, 1, 2048, 4)), mx.zeros((1, 1, 2048, 4)))
+        caps.add(r.keys.shape[2])
+    assert caps == {128 * 2048}
+
+
+@needs_mlx
+def test_growth_without_reserve_is_capped(monkeypatch):
+    """Without a reserve the capacity never goes above need + GROW_MAX (rounded up to the cache step)."""
+    import mlx.core as mx
+    from escha_mlx.kv_cache import GrowingKVCache
+    monkeypatch.setenv("ESCHA_MLX_KV_GROW_MAX", "1024")
+    c = GrowingKVCache()
+    k = mx.zeros((1, 2, 300, 8), mx.float16)
+    caps = []
+    for _ in range(40):                                   # 12,000 positions in chunks of 300
+        c.update_and_fetch(k, k)
+        cap = c.keys.shape[2]
+        caps.append(cap)
+        assert cap <= c.offset + 1024 + c.step, (c.offset, cap)
+    assert caps[-1] >= c.offset
+    assert len(set(caps)) > 5                             # it grew in steps, not once
+
+
+@needs_mlx
+def test_reserve_is_exact_past_the_cap(monkeypatch):
+    import mlx.core as mx
+    from escha_mlx.kv_cache import GrowingKVCache
+    monkeypatch.setenv("ESCHA_MLX_KV_GROW_MAX", "512")
+    c = GrowingKVCache()
+    c.reserve(10000)
+    c.update_and_fetch(mx.zeros((1, 2, 300, 8), mx.float16), mx.zeros((1, 2, 300, 8), mx.float16))
+    assert c.keys.shape[2] == 10240                        # 10000 rounded up to the step of 256
+
+
+@needs_mlx
+def test_growth_past_a_reservation_keeps_content(monkeypatch):
+    """reserve(4096), then 5000 positions: the growth past the reservation keeps the content and is capped."""
+    import mlx.core as mx
+    from escha_mlx.kv_cache import GrowingKVCache
+    monkeypatch.setenv("ESCHA_MLX_KV_GROW_MAX", "1024")
+    c = GrowingKVCache()
+    c.reserve(4096)
+    rng = np.random.default_rng(5)
+    x = mx.array(rng.standard_normal((1, 2, 5000, 8)).astype(np.float16))
+    for a in range(0, 5000, 1000):
+        c.update_and_fetch(x[:, :, a:a + 1000], x[:, :, a:a + 1000])
+    assert c.offset == 5000
+    assert 5000 <= c.keys.shape[2] <= 4096 + 1024 + c.step
+    k, v = c.state
+    assert mx.array_equal(k, x) and mx.array_equal(v, x)
