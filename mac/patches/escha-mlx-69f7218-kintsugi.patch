+"""K/V cache that grows geometrically and can be sized up front.
+
+mlx-lm's KVCache grows by `step` (256) with one concatenate per growth. A prefill chunk of L > 256 rows grows it
+on every chunk, so a long prompt copies the whole cache once per chunk (quadratic traffic) and holds two copies at
+each growth. Measured on an M5 Max 48 GB, 64k-token prefill at chunk 2048: 218 tok/s with the stock cache (swap
+grew by 2.8 GB), 480 tok/s with the cache sized up front.
+
+This class keeps KVCache's interface (state, trim, offset, nbytes, merge, to_quantized) and changes only growth:
+  * reserve(n): the next growth allocates at least n positions (callers that know the prompt length use it);
+  * otherwise capacity doubles, but by at most ESCHA_MLX_KV_GROW_MAX positions (default 32768, 2 GB for
+    Kintsugi-27B): the copies stay O(final size^2 / GROW_MAX) bytes, and a long prompt without a reserve never
+    holds more than GROW_MAX unused positions (a doubled 259k cache would be 34 GB, 2x the need);
+  * limit(n): no growth past n positions (a caller with a memory plan sets its context).
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-20.
+"""
+from __future__ import annotations
+
+import mlx.core as mx
+from mlx_lm.models.cache import KVCache
+
+from . import envs
+
+
+class GrowingKVCache(KVCache):
+    def __init__(self):
+        super().__init__()
+        self._reserve = 0
+        self._limit = 0
+
+    def reserve(self, n: int) -> None:
+        """Make the next growth (or the first allocation) at least n positions."""
+        self._reserve = max(self._reserve, int(n))
+
+    def limit(self, n: int) -> None:
+        """No growth past n positions (unless one write needs more): the caller's memory plan holds n."""
+        self._limit = int(n)
+
+    def update_and_fetch(self, keys, values):
+        prev = self.offset
+        need = prev + keys.shape[2]
+        cap = 0 if self.keys is None else self.keys.shape[2]
+        if need > cap:
+            B, n_kv_heads, _, k_head_dim = keys.shape
+            v_head_dim = values.shape[3]
+            new_cap = max(need, self._reserve, min(2 * cap, cap + envs.ESCHA_MLX_KV_GROW_MAX.get()))
+            new_cap = ((new_cap + self.step - 1) // self.step) * self.step
+            if self._limit:
+                new_cap = max(need, min(new_cap, self._limit))
+            new_k = mx.zeros((B, n_kv_heads, new_cap, k_head_dim), keys.dtype)
+            new_v = mx.zeros((B, n_kv_heads, new_cap, v_head_dim), values.dtype)
+            if self.keys is not None and prev:
+                new_k[..., :prev, :] = self.keys[..., :prev, :]
+                new_v[..., :prev, :] = self.values[..., :prev, :]
+            self.keys, self.values = new_k, new_v
+        self.offset = need
+        self.keys[..., prev:need, :] = keys
+        self.values[..., prev:need, :] = values
+        return self.keys[..., :need, :], self.values[..., :need, :]
+
+
+def reserve(cache, n: int) -> None:
+    """Call reserve(n) on every cache entry that has it (GDN state caches have no length)."""
+    for c in cache:
+        if hasattr(c, "reserve"):
+            c.reserve(n)
+
+
+def limit(cache, n: int) -> None:
+    """Call limit(n) on every cache entry that has it."""
+    for c in cache:
+        if hasattr(c, "limit"):
+            c.limit(n)
