+@needs_metal
+@pytest.mark.parametrize("K", [2, 3])
+@pytest.mark.parametrize("IC,OC", [(256, 512), (1024, 256)])
+@pytest.mark.parametrize("m", [1, 3, 4, 8])
+def test_pf_is_bit_identical_to_one_tile(monkeypatch, K, IC, OC, m):
+    """m=1 runs the prefetch kernel. m=3/4/8 use row groups R > 1 under the default row policy, so they run pf 1 and
+    this only checks that the knob leaves them unchanged. test_pf_with_block_r_1_at_several_rows covers prefetch at
+    several rows."""
+    import mlx.core as mx
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    lin = _linear(K, IC, OC, K * 1000 + IC + OC + m, bias=(m == 3))
+    rng = np.random.default_rng(m + IC)
+    x = mx.array(rng.standard_normal((1, m, IC)).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PF", "1")
+    ref = np.array(lin(x))
+    for pf in (2, 4, 8):
+        monkeypatch.setenv("ESCHA_MLX_DENSE_PF", str(pf))
+        got = np.array(lin(x))
+        assert np.array_equal(got, ref), f"K={K} {IC}x{OC} m={m} pf={pf}"
+
+
+@needs_metal
+def test_pf_falls_back_when_tiles_do_not_divide(monkeypatch):
+    """IC/16 = 24 tiles: pf=16 does not divide it, so the one-tile kernel runs (same bits, no error). Linear
+    dimensions are multiples of 128, so IC/16 is always a multiple of 8 and the default pf=8 always divides."""
+    import mlx.core as mx
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    lin = _linear(2, 384, 256, 9)
+    x = mx.array(np.random.default_rng(2).standard_normal((1, 1, 384)).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PF", "1")
+    ref = np.array(lin(x))
+    monkeypatch.setenv("ESCHA_MLX_DENSE_PF", "16")
+    assert np.array_equal(np.array(lin(x)), ref)
+
+
+@needs_metal
+def test_pf_really_builds_the_prefetch_kernel(monkeypatch):
+    """Guard against a vacuous equality: pf=8 must compile a distinct kernel (name suffix _pf8)."""
+    import mlx.core as mx
+    from escha_mlx import msl
+    seen = []
+    real = msl._dense_gemm_rows_direct_out_kernel
+
+    def spy(K, lut, R, rs, pf=1):
+        seen.append(pf)
+        return real(K, lut, R, rs, pf)
+
+    monkeypatch.setattr(msl, "_dense_gemm_rows_direct_out_kernel", spy)
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
