index 0000000..b086e85
--- /dev/null
+++ b/escha_mlx/flash_attn.py
@@ -0,0 +1,300 @@
+"""Fused causal flash attention for head dim 256 on the Apple GPU matrix units (Metal 4 MPP / NAX), prefill only.
+
+MLX 0.32 builds its matrix-unit attention kernel (steel attention_nax) only for head dims 64, 80 and 128, so for
+Qwen3.5 full attention (head dim 256) it builds the [H, L, S] score matrix. This module builds the same NAX algorithm
+for head dim 256 through mx.fast.metal_kernel:
+  - two simdgroups share each 16 query rows: each one owns half of the head dim, the QK partials add through
+    threadgroup memory, both run the same online softmax, each one does P V for its own 128 columns
+    (a 16 x 256 f32 O tile per simdgroup spills registers; 16 x 128 does not);
+  - GQA: the query heads in one threadgroup share one K/V head;
+  - q, k, v may be strided views (K/V are slices of a reserved cache); the head dim must be stride 1.
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-21.
+"""
+from __future__ import annotations
+
+import os
+import re
+from functools import lru_cache
+
+import mlx.core as mx
+
+_STEEL = ("mlx/backend/metal/kernels/steel/defines.h",
+          "mlx/backend/metal/kernels/steel/utils/type_traits.h",
+          "mlx/backend/metal/kernels/steel/utils/integral_constant.h",
+          "mlx/backend/metal/kernels/steel/attn/nax.h")
+
+
+@lru_cache(maxsize=None)
+def _header() -> str:
+    """The MLX steel NAX headers, inlined: the custom-kernel compiler has no MLX include path."""
+    root = os.path.join(os.path.dirname(mx.__file__), "include")
+    seen, out = set(), ["#include <metal_stdlib>", "#include <metal_simdgroup>", "#include <metal_simdgroup_matrix>",
+                        "#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>"]
+
+    def add(rel):
+        if rel in seen:
+            return
+        seen.add(rel)
+        for line in open(os.path.join(root, rel)).read().splitlines():
+            m = re.match(r'\s*#include\s+"(mlx/[^"]+)"', line)
+            if m:
+                add(m.group(1))
+            elif not line.strip().startswith("#pragma once"):
+                out.append(line)
+    for rel in _STEEL:
+        add(rel)
+    out.append("using namespace mlx::steel;")
+    return "\n".join(out) + "\n"
+
+
+def _source(BK: int, D: int, GH: int, RB: int, causal: bool, align_q: bool, align_k: bool, DB: bool) -> str:
+    return f"""
+    constexpr int BK = {BK}, BD = {D};
+    constexpr short kU = 16;
+    constexpr int GH = {GH};                             // query heads per threadgroup (they share one K/V head)
+    constexpr int RB = {RB};                             // 16-row query blocks per head
+    constexpr int BQ = kU * RB;                          // query rows per head per threadgroup
+    constexpr int NH = 2;                                // simdgroups per 16 query rows (head dim split in NH)
+    constexpr int kNWarps = GH * RB * NH;
+    constexpr int NB = {2 if DB else 1};                 // QK partial buffers (2: by kb parity, one barrier)
+    constexpr int TQ = 1;
+    constexpr int TD = BD / kU / NH;                     // head-dim fragments owned by this simdgroup
+    constexpr short TK = BK / kU;
+    using AccumType = float;
+    using T = half;
+
+    const uint3 tid = threadgroup_position_in_grid;
+    const uint simd_group_id = simdgroup_index_in_threadgroup;
+    // q, k, v may be views (K/V are slices of a reserved cache buffer): read their strides; head dim is stride 1
+    const ulong qs = q_strides[2], ks = k_strides[2], vs = v_strides[2], os = BD;
+    const int qL_off = S - L;
+    const int NK = (S + BK - 1) / BK;
+    const int NK_aligned = S / BK;
+    const int NQ_aligned = L / BQ;
+    const int qL_rem = L - NQ_aligned * BQ;
+    const int kL_rem = S - NK_aligned * BK;
+
+    const short pair = simd_group_id / NH;
+    const short half_ = simd_group_id % NH;
+    const short hl = pair / RB;                         // head inside this threadgroup
+    const uint hq = tid.y * GH + hl;
+    const device T* Qp = q + (ulong)tid.z * q_strides[0] + (ulong)hq * q_strides[1] + (ulong)tid.x * BQ * qs;
+    const ulong kvh = (tid.y * GH) / (HQ / HKV);
+    const device T* Kp = k + (ulong)tid.z * k_strides[0] + kvh * k_strides[1];
+    const device T* Vp = v + (ulong)tid.z * v_strides[0] + kvh * v_strides[1];
+    device T* Op = out + ((ulong)(tid.z * HQ + hq) * L + (ulong)tid.x * BQ) * os;
+
+    const float scale2 = scale * 1.44269504089f;
+
+    using otile_t = NAXTile<AccumType, TQ, TD>;
+    otile_t Otile;
+    Otile.clear();
+
+    const short tm = kU * TQ * (pair % RB);
+    const int d0 = half_ * TD * kU;                     // first head-dim column of this simdgroup
+    Qp += tm * qs + d0;
+    threadgroup float Sx[NB][kNWarps][32 * (16 * BK / 32)];   // QK partials of each simdgroup
+    const uint lane = thread_index_in_simdgroup;
+
+    const short2 simd_coord = otile_t::NAXFrag_t::get_coord();
+    const short sm = simd_coord.y;
+    const short sn = simd_coord.x;
+
+    constexpr short kRowsPT = otile_t::kRowsPerThread;
+    metal::vec<AccumType, kRowsPT> max_score;
+    metal::vec<AccumType, kRowsPT> sum_score{{0}};
+    constexpr AccumType neg_inf = -3.402823466e+38f;
+    for (short i = 0; i < kRowsPT; ++i) max_score[i] = neg_inf;
+
+    int kb_lim = NK;
+    int kb_min_causal = NK;
+    if ({str(causal).lower()}) {{
+        int q_max = (tid.x + 1) * BQ + qL_off;
+        kb_lim = min(NK, (q_max + BK - 1) / BK);
+        int q_min = max(0, (int)(tid.x * BQ) + qL_off);
+        kb_min_causal = q_min / BK;
+    }}
+    const bool is_last_q = int(tid.x) == NQ_aligned;
+    const short lim_rows_q = qL_rem - tm;
+    const short lim_rows_k = kL_rem;
+
+    for (int kb = 0; kb < kb_lim; kb++) {{
+        const bool is_last_k = (kb == NK_aligned);
+        using stile_t = NAXTile<AccumType, TQ, TK>;
+        stile_t Stile;
+        Stile.clear();
+
+        STEEL_PRAGMA_UNROLL
+        for (short ik = 0; ik < TK; ik += 2) {{
+            STEEL_PRAGMA_UNROLL
+            for (short id = 0; id < TD; id++) {{
+                NAXTile<T, 1, 1> Qtile;
+                NAXTile<T, 2, 1> Ktile;
+                const int Q_load_off = id * kU;
+                const int K_load_off = ik * kU * int(ks) + d0 + id * kU;
+                if (!{str(align_q).lower()} && is_last_q) Qtile.load_rows(Qp + Q_load_off, int(qs), lim_rows_q);
+                else Qtile.load(Qp + Q_load_off, int(qs));
+                if (!{str(align_k).lower()} && is_last_k) Ktile.load_rows(Kp + K_load_off, int(ks), lim_rows_k - ik * kU);
+                else Ktile.load(Kp + K_load_off, int(ks));
+                stile_t::NAXFrag_t::mma(Stile.frag_at(0, ik), Stile.frag_at(0, ik + 1), Qtile.frag_at(0, 0),
+                                        metal::false_type{{}}, Ktile.frag_at(0, 0), Ktile.frag_at(1, 0),
+                                        metal::true_type{{}});
+            }}
+        }}
+
+        {{   // add the partner partial: same fragment layout in both simdgroups, so lane/element positions match
+            threadgroup float* mine = Sx[kb % NB][simd_group_id] + lane * stile_t::kElemsPerTile;
+            threadgroup float* other = Sx[kb % NB][simd_group_id ^ 1] + lane * stile_t::kElemsPerTile;
+            STEEL_PRAGMA_UNROLL
+            for (short ii = 0; ii < stile_t::kElemsPerTile; ii++) mine[ii] = Stile.elems()[ii];
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            STEEL_PRAGMA_UNROLL
+            for (short ii = 0; ii < stile_t::kElemsPerTile; ii++)
+                Stile.elems()[ii] = (half_ == 0) ? (Stile.elems()[ii] + other[ii]) : (other[ii] + Stile.elems()[ii]);
+        }}
+        STEEL_PRAGMA_UNROLL
+        for (short ii = 0; ii < stile_t::kElemsPerTile; ii++) Stile.elems()[ii] *= scale2;
+
+        if (!{str(align_k).lower()} && is_last_k) {{
+            STEEL_PRAGMA_UNROLL
+            for (short ik = 0; ik < TK; ik++) {{
+                const short col_pos = ik * kU + sn;
+                thread auto& fg = Stile.frag_at(0, ik);
+                STEEL_PRAGMA_UNROLL
+                for (short ii = 0; ii < stile_t::kFragThrRows; ii++) {{
+                    STEEL_PRAGMA_UNROLL
+                    for (short jj = 0; jj < stile_t::kFragThrCols; jj++) {{
+                        const auto loc = ii * stile_t::kFragThrCols + jj;
+                        fg[loc] = ((col_pos + jj) < kL_rem) ? fg[loc] : neg_inf;
+                    }}
+                }}
+            }}
+        }}
+
+        if ({str(causal).lower()} && kb >= kb_min_causal) {{
+            const int base_row = tid.x * BQ + qL_off + tm;
+            const int base_col = kb * BK;
+            STEEL_PRAGMA_UNROLL
+            for (short ik = 0; ik < TK; ik++) {{
+                thread auto& fg = Stile.frag_at(0, ik);
+                STEEL_PRAGMA_UNROLL
+                for (short ii = 0; ii < stile_t::kFragThrRows; ii++) {{
+                    STEEL_PRAGMA_UNROLL
+                    for (short jj = 0; jj < stile_t::kFragThrCols; jj++) {{
+                        const auto r = base_row + ii * stile_t::kFragRowsJump + sm;
+                        const auto c = base_col + ik * kU + jj + sn;
+                        const auto loc = ii * stile_t::kFragThrCols + jj;
+                        fg[loc] = (r < c) ? neg_inf : fg[loc];
+                    }}
+                }}
+            }}
+        }}
+
+        metal::vec<AccumType, kRowsPT> new_max;
+        metal::vec<AccumType, kRowsPT> factor;
+        for (short i = 0; i < kRowsPT; ++i) new_max[i] = max_score[i];
+        Stile.template row_reduce<MaxOp>(new_max);
+        Stile.template row_bin_op<ExpSubOp>(new_max);
+        for (short i = 0; i < kRowsPT; ++i) {{
+            factor[i] = fast::exp2(max_score[i] - new_max[i]);
+            max_score[i] = new_max[i];
+            sum_score[i] = sum_score[i] * factor[i];
+        }}
+        Stile.template row_reduce<SumOp>(sum_score);
+        Otile.template row_bin_op<MulOp>(factor);
+        simdgroup_barrier(mem_flags::mem_none);
+
+        STEEL_PRAGMA_UNROLL
+        for (short id = 0; id < TD; id += 2) {{
+            STEEL_PRAGMA_UNROLL
+            for (short ik = 0; ik < TK; ik++) {{
+                NAXTile<T, 1, 2> Vtile;
+                const int V_load_off = ik * kU * int(vs) + d0 + id * kU;
+                if (!{str(align_k).lower()} && is_last_k) Vtile.load_rows(Vp + V_load_off, int(vs), lim_rows_k - ik * kU);
+                else Vtile.load(Vp + V_load_off, int(vs));
+                otile_t::NAXFrag_t::mma(Otile.frag_at(0, id), Otile.frag_at(0, id + 1), Stile.frag_at(0, ik),
+                                        metal::false_type{{}}, Vtile.frag_at(0, 0), Vtile.frag_at(0, 1),
+                                        metal::false_type{{}});
+            }}
+        }}
+        Kp += BK * ks;
+        Vp += BK * vs;
+        if (NB == 1) threadgroup_barrier(mem_flags::mem_threadgroup);   // partner read done before next write
+    }}
+
+    threadgroup_barrier(mem_flags::mem_none);
+    metal::vec<AccumType, kRowsPT> rcp;
+    for (short i = 0; i < kRowsPT; ++i) rcp[i] = 1.f / sum_score[i];
+    Otile.template row_bin_op<MulOp>(rcp);
+    Op += tm * os + d0;
+    if (!{str(align_q).lower()} && is_last_q) {{
+        if (lim_rows_q <= 0) return;
+        Otile.store_rows(Op, int(os), lim_rows_q);
+    }} else {{
+        Otile.store(Op, int(os));
+    }}
+"""
+
+
+_OPS = """
+struct MaxOp { template <typename T> METAL_FUNC static constexpr T apply(T x, T y) { return metal::max(x, y); } };
+struct SumOp { template <typename T> METAL_FUNC static constexpr T apply(T x, T y) { return x + y; } };
+struct MulOp { template <typename T> METAL_FUNC static constexpr T apply(T x, T y) { return x * y; } };
+struct ExpSubOp { template <typename T> METAL_FUNC static constexpr T apply(T x, T y) { return fast::exp2(x - y); } };
+"""
+
+
+@lru_cache(maxsize=None)
+def _kernel(BK, D, GH, RB, causal, align_q, align_k, DB):
+    tag = f"d{D}_k{BK}_g{GH}_r{RB}{'_db' if DB else ''}{'_c' if causal else ''}{'_aq' if align_q else ''}{'_ak' if align_k else ''}"
+    return mx.fast.metal_kernel(
+        name=f"kintsugi_flash_nax_{tag}", input_names=["q", "k", "v", "scale"], output_names=["out"],
+        header=_header() + _OPS, source=_source(BK, D, GH, RB, causal, align_q, align_k, DB),
+        ensure_row_contiguous=False)
+
+
+def flash_attention(q, k, v, scale: float, causal: bool, BK: int = 32, GH: int = 1, RB: int = 4, DB: bool = False):
+    """GH query heads (sharing one K/V head) x RB 16-row blocks per threadgroup; 2 simdgroups per 16 rows."""
+    B, HQ, L, D = q.shape
+    HKV, S = k.shape[1], k.shape[2]
+    if (HQ // HKV) % GH:
+        raise ValueError(f"GH={GH} must divide the GQA factor {HQ // HKV}")
+    BQ = 16 * RB
+    nw = GH * RB * 2
+    kern = _kernel(BK, D, GH, RB, causal, L % BQ == 0, S % BK == 0, DB)
+    (o,) = kern(
+        inputs=[q.astype(mx.float16), k.astype(mx.float16), v.astype(mx.float16), mx.array(scale, mx.float32)],
+        template=[("HQ", HQ), ("HKV", HKV), ("L", L), ("S", S)],
+        grid=(((L + BQ - 1) // BQ) * 32 * nw, HQ // GH, B), threadgroup=(32 * nw, 1, 1),
+        output_shapes=[(B, HQ, L, D)], output_dtypes=[mx.float16])
+    return o
+
+
+def enabled() -> bool:
+    """ESCHA_MLX_ATTN_FLASH (default auto). auto = on for GPUs with matrix units (applegpu_g17, M5, and later) when
+    the kernel builds and matches the reference on a small case; on = the same check, but a failure raises.
+    The env var is read on every call; only the GPU check is cached (per mode)."""
+    from . import envs
+    return _works(envs.ESCHA_MLX_ATTN_FLASH.get())
+
+
+@lru_cache(maxsize=None)
+def _works(mode: str) -> bool:
+    from .int8_gemm import _gpu_generation
+    if mode == "off":
+        return False
+    if mode == "auto" and _gpu_generation() < 17:
+        return False
+    try:
+        q = mx.random.normal((1, 6, 40, 256), key=mx.random.key(1)).astype(mx.float16)
+        k = mx.random.normal((1, 1, 72, 256), key=mx.random.key(2)).astype(mx.float16)
+        v = mx.random.normal((1, 1, 72, 256), key=mx.random.key(3)).astype(mx.float16)
+        ref = mx.fast.scaled_dot_product_attention(q, k, v, scale=0.0625, mask="causal")
+        got = flash_attention(q, k, v, 0.0625, True)
+        ok = float(mx.abs(got.astype(mx.float32) - ref.astype(mx.float32)).max()) < 1e-2
+    except Exception:  # noqa: BLE001 -- no Metal 4 / MPP: use the blocked path
+        ok = False
+    if not ok and mode == "on":
+        raise RuntimeError("ESCHA_MLX_ATTN_FLASH=on, but the head-dim-256 flash kernel does not build or is wrong here")
+    return ok
