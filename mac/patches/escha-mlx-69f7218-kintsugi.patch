@@ -0,0 +1,163 @@
+"""Per-group Q8 scales and pre-quantized affine linears (Kintsugi-27B addition, 2026-11-20).
+
+Added to escha-mlx (Escha Labs, Apache-2.0) by the Kintsugi-27B project. CPU tests need mlx (mlx[cpu] works);
+the kernel test needs Metal.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal, needs_mlx
+
+
+@needs_mlx
+@pytest.mark.parametrize("group", [32, 64, 128])
+def test_q8_grouped_repack_bit_exact(group):
+    from escha_mlx import quant
+    quant._VALIDATED_GROUPED.discard(group)
+    quant.validate_pack_grouped(group)
+
+
+@needs_mlx
+def test_q8_grouped_matches_ggml_q8_0_values():
+    """dequant == f32(d) * q for every value: the ggml dequantize_row_q8_0 result."""
+    import mlx.core as mx
+
+    from escha_mlx import quant
+    rng = np.random.default_rng(7)
+    w8 = rng.integers(-127, 128, size=(64, 512), dtype=np.int8)
+    d = (rng.random((64, 16), dtype=np.float32) * 0.02 + 1e-5).astype(np.float16)
+    packed, scales, biases, g = quant.pack_q8_grouped(w8, d)
+    assert g == 32
+    got = np.array(mx.dequantize(mx.array(packed), mx.array(scales), mx.array(biases), group_size=g, bits=8))
+    want = (w8.astype(np.float32).reshape(64, 16, 32) * d.astype(np.float32)[:, :, None]).reshape(64, 512)
+    assert np.array_equal(got.view(np.uint32), want.view(np.uint32))
+
+
+@needs_mlx
+def test_affine_q4_linear_is_exact_for_q4_0_blocks():
+    import mlx.core as mx
+
+    from escha_mlx import quant
+    rng = np.random.default_rng(8)
+    n, k = 32, 256
+    q = rng.integers(0, 16, size=(n, k), dtype=np.uint32)
+    d = (rng.random((n, k // 32), dtype=np.float32) * 0.02 + 1e-5).astype(np.float16).astype(np.float32)
+    packed = np.zeros((n, k // 8), dtype=np.uint32)
+    for j in range(8):
+        packed |= q.reshape(n, k // 8, 8)[:, :, j] << np.uint32(4 * j)
+    lin = quant.EschaAffineLinear(n, k, 32, 4)
+    lin.weight, lin.scales, lin.biases = mx.array(packed), mx.array(d), mx.array(-8.0 * d)
+    got = np.array(mx.dequantize(lin.weight, lin.scales, lin.biases, group_size=32, bits=4))
+    want = ((q.astype(np.int32) - 8).astype(np.float32).reshape(n, -1, 32) * d[:, :, None]).reshape(n, k)
+    assert np.array_equal(got.view(np.uint32), want.view(np.uint32))
+    x = mx.array(rng.standard_normal((3, k)).astype(np.float16))
+    y = lin(x)
+    assert y.dtype == mx.float16 and y.shape == (3, n)
+
+
+@needs_mlx
+def test_head_detects_row_vs_group_scales():
+    from escha_mlx import quant
+    rng = np.random.default_rng(9)
+    w8 = rng.integers(-128, 128, size=(8, 512), dtype=np.int8)
+    row = (rng.random(8) * 0.01 + 1e-3).astype(np.float16)
+    assert quant.EschaQ8Head(*quant.pack_q8(w8, row, 32), 32)._row_scales
+    grp = (rng.random((8, 16)) * 0.01 + 1e-3).astype(np.float16)
+    p, s, b, g = quant.pack_q8_grouped(w8, grp)
+    assert not quant.EschaQ8Head(p, s, b, g)._row_scales
+
+
+@needs_metal
+@pytest.mark.parametrize("rows", [1, 3, 8])
+def test_grouped_q8_head_kernel_close_to_mlx_and_keeps_top1(monkeypatch, rows):
+    import mlx.core as mx
+
+    from escha_mlx import quant
+    rng = np.random.default_rng(1300 + rows)
+    n, k = 263, 512
+    w8 = rng.integers(-127, 128, size=(n, k), dtype=np.int8)
+    d = (rng.random((n, k // 32)) * 0.01 + 1e-3).astype(np.float16)
+    packed, scales, biases, g = quant.pack_q8_grouped(w8, d)
+    standard = quant.EschaQ8Linear(packed, scales, biases, g)
+    head = quant.EschaQ8Head(packed, scales, biases, g)
+    x = mx.array(rng.standard_normal((1, rows, k)).astype(np.float16))
+    monkeypatch.setenv("ESCHA_MLX_Q8_HEAD", "1")
+    reference, got, again = standard(x), head(x), head(x)
+    mx.eval(reference, got, again)
+    delta = mx.abs(reference.astype(mx.float32) - got.astype(mx.float32))
+    relative = float(delta.max()) / max(float(mx.abs(reference).mean()), 1e-6)
+    assert relative < 5e-3
+    assert bool((got.view(mx.uint16) == again.view(mx.uint16)).all())
+    assert np.array_equal(np.array(mx.argmax(got, axis=-1)), np.array(mx.argmax(reference, axis=-1)))
+    # the per-row kernel on these scales would be wrong: make sure it is not the one that ran
+    wrong = quant.q8_head(x, head.weight, head.scales, g, grouped=False)
+    mx.eval(wrong)
+    assert float(mx.abs(wrong.astype(mx.float32) - reference.astype(mx.float32)).max()) > float(delta.max())
+
+
+# ---- CPU-side embedding (ESCHA_MLX_EMBED_CPU, Kintsugi-27B addition, 2026-11-20) --------------------------------
+
+def _q8_table(n, k, groups, seed):
+    rng = np.random.default_rng(seed)
+    w8 = rng.integers(-128, 128, size=(n, k), dtype=np.int8)
+    w8[0, :] = -128
+    w8[1, :] = 127
+    # scales over many binades, f16 subnormals included, as ggml Q8_0 blocks can hold
+    d = (2.0 ** rng.uniform(-24, 0, size=(n, groups))).astype(np.float16)
+    return w8, d
+
+
+@needs_mlx
+@pytest.mark.parametrize("groups", [1, 16, 160])
+def test_cpu_embedding_bit_equal_to_gpu_embedding(groups):
+    import mlx.core as mx
+
+    from escha_mlx import quant
+    k = 5120 if groups == 160 else 512
+    w8, d = _q8_table(300, k, groups, groups)
+    if groups == 1:
+        gpu = quant.make_embedding(w8, d[:, 0])
+        cpu = quant.make_embedding_cpu(w8, d[:, 0])
+    else:
+        gpu = quant.make_embedding_grouped(w8, d)
+        cpu = quant.make_embedding_cpu(w8, d)
+    ids = mx.array(np.random.default_rng(1).integers(0, 300, size=(3, 41)).astype(np.int32))
+    got, want = cpu(ids), gpu(ids)
+    assert got.dtype == want.dtype == mx.float16
+    assert got.shape == want.shape == (3, 41, k)
+    assert np.array_equal(np.array(got).view(np.uint16), np.array(want).view(np.uint16))
+    assert cpu.parameters() == {}                  # nothing of the table is an MLX array
+
+
+@needs_mlx
+def test_cpu_embedding_rejects_out_of_range_ids():
+    import mlx.core as mx
+
+    from escha_mlx import quant
+    w8, d = _q8_table(8, 64, 2, 0)
+    emb = quant.make_embedding_cpu(w8, d)
+    with pytest.raises(IndexError):
+        emb(mx.array([[8]]))
+
+
+def test_iter_tensors_memmap_matches_safe_open(tmp_path, monkeypatch):
+    from safetensors.numpy import save_file
+
+    from escha_mlx import loader
+    rng = np.random.default_rng(5)
+    tensors = {
+        "a.weight_int8": rng.integers(-128, 128, size=(7, 96), dtype=np.int8),
+        "model.language_model.embed_tokens.weight_group_scale": rng.random((7, 3)).astype(np.float16),
+        "b.norm": rng.random(33).astype(np.float16),
+    }
+    save_file(tensors, str(tmp_path / "model.safetensors"))
+    for embed_cpu, mapped in (("0", {"a.weight_int8"}),
+                              ("1", {"a.weight_int8", "model.language_model.embed_tokens.weight_group_scale"})):
+        monkeypatch.setenv("ESCHA_MLX_EMBED_CPU", embed_cpu)
+        seen = dict(loader._iter_tensors(tmp_path))
+        assert set(seen) == set(tensors)
+        assert {k for k, v in seen.items() if isinstance(v, np.memmap)} == mapped
+        for k, v in tensors.items():
+            assert seen[k].dtype == v.dtype and np.array_equal(seen[k], v)
