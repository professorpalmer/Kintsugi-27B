+def _fake_stack(n_layers):
+    import mlx.nn as nn
+
+    class Proj(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.int8_ok = True
+
+    class Layer(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.mlp = Proj()
+            self.self_attn = Proj()
+
+    class Stack(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.norm = Proj()                               # outside the layer list: never touched
+            self.layers = [Layer() for _ in range(n_layers)]
+
+    class Model(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.model = Stack()
+    return Model()
+
