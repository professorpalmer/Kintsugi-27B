+def make_head_grouped(w8: np.ndarray, group_scale: np.ndarray) -> nn.Module:
+    n, k = w8.shape
+    if dense_mode() == "fp16":
+        lin = nn.Linear(k, n, bias=False)
+        lin.weight = mx.array(_grouped_fp16(w8, group_scale))
+        return lin
+    packed, scales, biases, g = pack_q8_grouped(w8, group_scale)
+    validate_pack_grouped(g)
+    return EschaQ8Head(packed, scales, biases, g)
