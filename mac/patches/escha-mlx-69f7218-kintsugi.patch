+@needs_metal
+@pytest.mark.parametrize("K", [2, 3])
+@pytest.mark.parametrize("m", [2, 4, 8])
+def test_pf_with_block_r_1_at_several_rows(monkeypatch, K, m):
+    """With ESCHA_MLX_DENSE_BLOCK_R=1 pinned, 2..8 rows run R=1 groups, so they DO prefetch. Same bits as pf 1."""
+    import mlx.core as mx
