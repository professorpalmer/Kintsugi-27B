+"""ESCHA_MLX_GDN_GATE_ROWS: the f16 GDN gate projections run one GEMV per row for 2..N rows.
+
+Contract: for 2..N rows each output row equals the one-row call on that row, bit for bit (the AR decode bits).
+Outside 2..N the wrapper is the unchanged module call.
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-21.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from .conftest import needs_mlx
+
+
+def _linear(ic=256, oc=48, seed=3):
+    import mlx.core as mx
+    import mlx.nn as nn
+    lin = nn.Linear(ic, oc, bias=False)
+    rng = np.random.default_rng(seed)
+    lin.weight = mx.array((rng.standard_normal((oc, ic)) * 0.05).astype(np.float16))
+    return lin
+
+
+@needs_mlx
+@pytest.mark.parametrize("m", [1, 2, 3, 5, 8, 9, 64])
+def test_rows_equal_one_row_calls(m):
+    import mlx.core as mx
+    from escha_mlx.models.qwen3_5 import _GateRowsLinear
+    lin = _linear()
+    wrap = _GateRowsLinear(lin, 8)
+    rng = np.random.default_rng(m)
+    x = mx.array(rng.standard_normal((1, m, 256)).astype(np.float16))
+    y = np.array(wrap(x))
+    assert y.shape == (1, m, 48)
+    if 2 <= m <= 8:
+        want = np.concatenate([np.array(lin(x[:, i:i + 1])) for i in range(m)], axis=1)
+    else:
+        want = np.array(lin(x))
+    assert np.array_equal(y, want)
+
+
+@needs_mlx
+def test_install_respects_the_knob(monkeypatch):
+    import mlx.nn as nn
+    from escha_mlx.models import qwen3_5 as q
+
+    def fake():
+        layers = [SimpleNamespace(linear_attn=SimpleNamespace(in_proj_a=_linear(), in_proj_b=_linear(seed=4))),
+                  SimpleNamespace(linear_attn=None)]
+        return SimpleNamespace(language_model=SimpleNamespace(model=SimpleNamespace(layers=layers)))
+
+    monkeypatch.setenv("ESCHA_MLX_GDN_GATE_ROWS", "0")
+    m0 = fake()
+    assert q.install_gate_rows(m0) == 0
+    assert type(m0.language_model.model.layers[0].linear_attn.in_proj_a) is nn.Linear
+    monkeypatch.setenv("ESCHA_MLX_GDN_GATE_ROWS", "8")
+    m8 = fake()
+    assert q.install_gate_rows(m8) == 2
+    gdn = m8.language_model.model.layers[0].linear_attn
+    assert isinstance(gdn.in_proj_a, q._GateRowsLinear) and isinstance(gdn.in_proj_b, q._GateRowsLinear)
+    assert q.install_gate_rows(m8) == 0                       # idempotent: a wrapper is not wrapped again
+
+
+@needs_mlx
+@pytest.mark.parametrize("m,want_calls", [(1, 1), (4, 4), (8, 8), (9, 1)])
+def test_rows_path_really_calls_one_row_at_a_time(m, want_calls):
+    """Guard against a vacuous equality: 2..N rows must reach the inner module once per row, other counts once."""
+    import mlx.core as mx
+    from escha_mlx.models.qwen3_5 import _GateRowsLinear
+    lin = _linear()
+    seen = []
+
+    class Spy:
+        def __call__(self, x):
+            seen.append(x.reshape(-1, x.shape[-1]).shape[0])
+            return lin(x)
+
+    wrap = _GateRowsLinear(lin, 8)
+    wrap.inner = Spy()
+    mx.eval(wrap(mx.zeros((1, m, 256), mx.float16)))
+    assert len(seen) == want_calls
+    assert all(r == (1 if 2 <= m <= 8 else m) for r in seen)
+
+
+@needs_mlx
+@pytest.mark.parametrize("shape", [(2, 1), (5, 1), (8, 1), (2, 3), (3, 3), (9, 1)])
+def test_batch_rows_equal_one_row_calls(shape):
+    """[B, T, H] is flattened to B*T rows: a batch of one-token rows and a short prefill tail take the same rule."""
+    import mlx.core as mx
+    from escha_mlx.models.qwen3_5 import _GateRowsLinear
+    lin = _linear()
+    wrap = _GateRowsLinear(lin, 8)
+    b, t = shape
+    rng = np.random.default_rng(b * 10 + t)
+    x = mx.array(rng.standard_normal((b, t, 256)).astype(np.float16))
+    y = np.array(wrap(x))
+    assert y.shape == (b, t, 48)
+    if 2 <= b * t <= 8:
+        want = np.stack([np.concatenate([np.array(lin(x[i:i + 1, j:j + 1]))[0] for j in range(t)], axis=0)
+                         for i in range(b)])
+    else:
+        want = np.array(lin(x))
+    assert np.array_equal(y, want)
