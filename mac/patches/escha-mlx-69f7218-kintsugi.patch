+"""int8 decode-once GEMM (escha_mlx.int8_gemm).
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-20 (changed 2026-11-22).
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal
+from .test_dense_linear import _synth
+
+pytestmark = pytest.mark.int8
+
+
+def _int8_or_skip():
+    from escha_mlx import int8_gemm
+    if not int8_gemm.enabled():
+        pytest.skip("no MPP int8 GEMM on this GPU")
+    return int8_gemm
+
+
+@needs_metal
+@pytest.mark.recon
+@pytest.mark.parametrize("K", [2, 3])
+def test_decode_i8_is_rint_of_decode_times_32(K):
+    import mlx.core as mx
+    from escha_mlx import dense, msl
+    g8 = _int8_or_skip()
+    w = dense.build(_synth(K, np.random.default_rng(K), 256, 2048))._w
+    got = np.array(g8.decode_i8(w.code, w.K, w.IC, w.OC)).astype(np.int32)
+    ref = np.array(msl.decode_tiles(w.code, w.K, w.IC, w.OC)).astype(np.float32)
+    assert np.abs(ref).max() * 32 < 127.5
+    assert np.array_equal(got, np.rint(ref * 32).astype(np.int32))
+
+
+@needs_metal
+@pytest.mark.recon
+@pytest.mark.parametrize("M,IC", [(1, 256), (77, 5120), (128, 17408)])
+def test_quantize_rows(M, IC):
+    import mlx.core as mx
+    g8 = _int8_or_skip()
+    x = (np.random.default_rng(M).standard_normal((M, IC)) * 0.3).astype(np.float16)
+    q, s = g8.quantize_rows_i8(mx.array(x))
+    q, s = np.array(q).astype(np.int32), np.array(s)
+    want_s = np.abs(x.astype(np.float32)).max(axis=1) / 127.0
+    assert np.allclose(s, want_s, rtol=1e-6)
+    want_q = np.rint(x.astype(np.float32) * (127.0 / np.abs(x.astype(np.float32)).max(axis=1, keepdims=True)))
+    assert np.abs(q - want_q).max() <= 1          # ties at .5 may round either way
+
+
+@needs_metal
+@pytest.mark.recon
+@pytest.mark.parametrize("M,K,N", [(128, 256, 2048), (200, 512, 1024), (64, 5120, 128)])
+def test_gemm_epilogue_matches_float(M, K, N):
+    import mlx.core as mx
+    g8 = _int8_or_skip()
+    rng = np.random.default_rng(M + N)
+    a = rng.integers(-127, 128, (M, K)).astype(np.int8)
+    b = rng.integers(-127, 128, (K, N)).astype(np.int8)
+    s = rng.uniform(0.001, 0.01, M).astype(np.float32)
+    got = np.array(g8.gemm_i8_scaled(mx.array(a), mx.array(b), mx.array(s)))
+    want = (a.astype(np.int64) @ b.astype(np.int64)).astype(np.float64) * s[:, None] / 32.0
+    assert np.allclose(got, want, rtol=1e-6, atol=1e-6)
+
+
+@needs_metal
+@pytest.mark.recon
+@pytest.mark.parametrize("K", [2, 3])
