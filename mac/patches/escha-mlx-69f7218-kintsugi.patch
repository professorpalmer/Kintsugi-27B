+def test_quantize_blocks(M, IC, BK):
+    import mlx.core as mx
+    g8 = _blk_or_skip()
+    x = (np.random.default_rng(M).standard_normal((M, IC)) * 0.3).astype(np.float32)
+    x[:, 7] *= 40.0                                        # one outlier column: only its block gets a coarse scale
+    x = x.astype(np.float16)
+    q, s = g8.quantize_blocks_i8(mx.array(x), BK)
+    q, s = np.array(q).astype(np.int32), np.array(s)
+    xb = x.astype(np.float32).reshape(M, IC // BK, BK)
+    mx_ = np.maximum(np.abs(xb).max(axis=2), 1e-8)
+    assert np.allclose(s, mx_ / 127.0, rtol=1e-6)
+    want_q = np.rint(xb * (127.0 / mx_[:, :, None])).reshape(M, IC)
+    assert np.abs(q - want_q).max() <= 1
