@@ -0,0 +1,104 @@
+"""Gate the fused one-row dense linear (ESCHA_MLX_DENSE_FUSED_M1) against the unfused chain.
+
+The fused path runs the barrier-free direct GEMM at R=1 with the output Hadamard/rout in its epilogue. The unfused
+chain runs dense_gemv and then dense_scaled_had_out. Both keep the same kt/j accumulation order, lane reduction and
+f32 butterfly, so the f16 output must be BIT-IDENTICAL, not merely close.
+
+Modification notice (Apache-2.0, section 4(b)): added by the Kintsugi-27B project on 2026-11-21.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from .conftest import needs_metal, needs_mlx
+
+
+def _build(g, monkeypatch, fused: bool, bias: bool = True):
+    from escha_mlx import dense
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1" if fused else "0")
+    monkeypatch.setenv("ESCHA_MLX_BIAS", "1" if bias else "0")
+    group = {"escha_code": g["code"], "escha_rin": g["rin"], "escha_rout": g["rout"],
+             "escha_s_in": g["s_in"], "escha_s_out": g["s_out"]}
+    if bias:
+        group["bias"] = g["bias"]
+    return dense.build(group)
+
+
+@needs_metal
+@pytest.mark.parametrize("bias", [False, True])
+def test_fused_m1_matches_unfused_bit_exact(dense_linear_golden, monkeypatch, bias):
+    import mlx.core as mx
+    g = dense_linear_golden
+    fused = _build(g, monkeypatch, True, bias)
+    plain = _build(g, monkeypatch, False, bias)
+    assert fused._fused_m1 and not plain._fused_m1
+    assert (fused.bias is not None) == bias
+    rng = np.random.default_rng(31)
+    xs = np.concatenate([g["x"], (rng.standard_normal((24, 128)) * 2.0).astype(np.float16)])
+    for i in range(xs.shape[0]):
+        x = mx.array(xs[i:i + 1])
+        a, b = np.array(fused(x)), np.array(plain(x))
+        assert np.array_equal(a, b), f"row {i}: max diff {np.abs(a.astype(np.float32) - b).max()}"
+    x3 = mx.array(xs[:1])[None]                                  # [1, 1, IC] as a decode step passes it
+    assert np.array_equal(np.array(fused(x3)), np.array(plain(x3)))
+
+
+@needs_metal
+@pytest.mark.parametrize("K", [2, 3])
+@pytest.mark.parametrize("IC,OC", [(256, 512), (512, 1024)])
+def test_fused_m1_matches_unfused_on_random_streams(monkeypatch, K, IC, OC):
+    """Several 128-blocks on each side and a full random code stream, both rates."""
+    import mlx.core as mx
+    from escha_mlx import dense
+    rng = np.random.default_rng(K * 1000 + IC + OC)
+    code = rng.integers(-2**15, 2**15, size=(IC // 16, OC // 16, 16 * K), dtype=np.int64).astype(np.int16)
+    rin = (rng.random(IC) + 0.5).astype(np.float16)
+    rout = (rng.random(OC) + 0.5).astype(np.float16)
+    mods = {}
+    for fused in (True, False):
+        monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1" if fused else "0")
+        mods[fused] = dense.EschaLinear(dense.EschaWeight(code, rin, rout))
+    for i in range(6):
+        x = mx.array(rng.standard_normal((1, IC)).astype(np.float16))
+        a, b = np.array(mods[True](x)), np.array(mods[False](x))
+        assert np.array_equal(a, b), f"K={K} {IC}x{OC} row {i}"
+
+
+@needs_mlx
+def test_fused_m1_is_latched_at_construction(dense_linear_golden, monkeypatch):
+    from escha_mlx import msl
+    monkeypatch.delenv("ESCHA_MLX_DENSE_FUSED_M1", raising=False)
+    assert msl.use_dense_fused_m1() is True                     # default on
+    lin = _build(dense_linear_golden, monkeypatch, False)
+    monkeypatch.setenv("ESCHA_MLX_DENSE_FUSED_M1", "1")
+    assert lin._fused_m1 is False
+
+
+@needs_metal
+def test_fused_m1_really_dispatches_the_fused_kernel(dense_linear_golden, monkeypatch):
+    """Guard against a vacuous equality: with the flag on, a one-row call must reach the fused direct kernel and
+    must not reach dense_gemv; with the flag off, the reverse."""
+    import mlx.core as mx
+    from escha_mlx import msl
+    calls = {"direct_out": 0, "gemv": 0}
+    real_out, real_gemv = msl.dense_gemm_rows_direct_out, msl.dense_gemv
+
+    def spy_out(*a, **k):
+        calls["direct_out"] += 1
+        return real_out(*a, **k)
+
+    def spy_gemv(*a, **k):
+        calls["gemv"] += 1
+        return real_gemv(*a, **k)
+
+    g = dense_linear_golden
+    fused = _build(g, monkeypatch, True)
+    plain = _build(g, monkeypatch, False)
+    monkeypatch.setattr(msl, "dense_gemm_rows_direct_out", spy_out)
+    monkeypatch.setattr(msl, "dense_gemv", spy_gemv)
+    x = mx.array(g["x"][:1])
+    mx.eval(fused(x))
+    assert calls == {"direct_out": 1, "gemv": 0}
+    mx.eval(plain(x))
+    assert calls == {"direct_out": 1, "gemv": 1}
